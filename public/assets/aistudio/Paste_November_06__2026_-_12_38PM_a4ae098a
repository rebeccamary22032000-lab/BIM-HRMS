function applySandwichLeavePolicy_(name) {
  try {
    const leaveSh = ensureLeaveSheet_();
    const leaveData = leaveSh.getDataRange().getValues();
    const approvedDates = new Set();
    for (let i = 1; i < leaveData.length; i++) {
      if (!leaveData[i][0]) continue;
      if (String(leaveData[i][1]).trim() === String(name).trim() && (leaveData[i][4] || 'Approved') === 'Approved') {
        approvedDates.add(normalizeDateCell_(leaveData[i][0]));
      }
    }
    const profile = getMyProfile(name);
    const weekOffCsv = profile.weekOff || '';
    const altSaturday = profile.altSaturday || '';

    const holidayData = ensureHolidaysSheet_().getDataRange().getValues();
    const holidayDates = new Set();
    for (let i = 1; i < holidayData.length; i++) {
      if (holidayData[i][0]) holidayDates.add(normalizeDateCell_(holidayData[i][0]));
    }

    const toAdd = [];
    approvedDates.forEach(dateStr => {
      const d = new Date(dateStr + 'T00:00:00');
      const nextDay = new Date(d); nextDay.setDate(d.getDate() + 1);
      const nextDayStr = fmtDate_(nextDay);
      const dayAfterNext = new Date(d); dayAfterNext.setDate(d.getDate() + 2);
      const dayAfterNextStr = fmtDate_(dayAfterNext);
      const nextIsOff = isWeekOffDay_(weekOffCsv, altSaturday, nextDay) || holidayDates.has(nextDayStr);
      if (!approvedDates.has(nextDayStr) && nextIsOff && approvedDates.has(dayAfterNextStr) && toAdd.indexOf(nextDayStr) === -1) {
        toAdd.push(nextDayStr);
      }
    });

    toAdd.forEach(dateStr => {
      const note = holidayDates.has(dateStr)
        ? 'Sandwich policy — public holiday between two leave days'
        : 'Sandwich policy — weekly off between two leave days';
      safeAppend_(leaveSh, [dateStr, name, note, 'System', 'Approved']);
    });
  } catch (err) {
    console.error('applySandwichLeavePolicy_ failed: ' + err.message);
  }
}

