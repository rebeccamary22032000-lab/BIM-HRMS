// ---------- PERFORMANCE SCORE ----------
const PUNCTUALITY_WEIGHT = 0.3;
const PRODUCTIVITY_WEIGHT = 0.7;
const STANDARD_WORKDAY_HOURS = 8;
const POINTS_PER_ERROR = 2;
const MAX_ERROR_PENALTY = 30;

function computePunctualityStats_(name) {
  const data = sheet_('TimeLog').getDataRange().getValues();
  let onTime = 0, late = 0;
  for (let i = 1; i < data.length; i++) {
    if (data[i][1] === name) {
      if (data[i][16] === 'On Time') onTime++;
      else if (data[i][16] === 'Late') late++;
    }
  }
  return { onTime, late };
}

function computeProductivityStats_(name) {
  const data = sheet_('TimeLog').getDataRange().getValues();
  let totalProdMin = 0;
  const daysSet = {};
  for (let i = 1; i < data.length; i++) {
    if (data[i][1] === name) {
      daysSet[normalizeDateCell_(data[i][0])] = true;
      if (data[i][7]) totalProdMin += parseDurationToMs_(data[i][14]) / 60000;
    }
  }
  return { totalProdMin, daysWorked: Object.keys(daysSet).length };
}

function countQCErrors_(name) {
  const data = sheet_('QCLog').getDataRange().getValues();
  let count = 0;
  for (let i = 1; i < data.length; i++) {
    if (data[i][3] === name) count += Number(data[i][7]) || 1;
  }
  return count;
}

function computePerformanceScore_(name) {
  const { onTime, late } = computePunctualityStats_(name);
  const punctualityEntries = onTime + late;
  const punctualityPct = punctualityEntries > 0 ? (onTime / punctualityEntries) * 100 : 100;

  const { totalProdMin, daysWorked } = computeProductivityStats_(name);
  const expectedMin = daysWorked * STANDARD_WORKDAY_HOURS * 60;
  let productivityPctRaw = expectedMin > 0 ? (totalProdMin / expectedMin) * 100 : 0;
  productivityPctRaw = Math.min(100, productivityPctRaw);

  const errorCount = countQCErrors_(name);
  const errorPenalty = Math.min(MAX_ERROR_PENALTY, errorCount * POINTS_PER_ERROR);
  const productivityPct = Math.max(0, productivityPctRaw - errorPenalty);
  const performanceScore = (punctualityPct * PUNCTUALITY_WEIGHT) + (productivityPct * PRODUCTIVITY_WEIGHT);
  const ctx = getLeavePermissionContext_(name);

  return {
    name: name,
    punctualityPct: Math.round(punctualityPct * 10) / 10,
    productivityPct: Math.round(productivityPct * 10) / 10,
    productivityPctBeforePenalty: Math.round(productivityPctRaw * 10) / 10,
    performanceScore: Math.round(performanceScore * 10) / 10,
    onTime: onTime, late: late, daysWorked: daysWorked,
    totalHours: fmtHMS_(totalProdMin * 60000),
    expectedHours: fmtHMS_(expectedMin * 60000),
    errorCount: errorCount, errorPenalty: errorPenalty,
    approvedLeaveCount: ctx.leaveCount, longPermissionCount: ctx.longPermissionCount
  };
}

function getLeavePermissionContext_(name) {
  let leaveCount = 0;
  try {
    const leaveData = ensureLeaveSheet_().getDataRange().getValues();
    for (let i = 1; i < leaveData.length; i++) {
      if (!leaveData[i][0]) continue;
      if ((leaveData[i][4] || 'Approved') === 'Approved' && String(leaveData[i][1]).trim() === String(name).trim()) leaveCount++;
    }
  } catch (err) {}
  let longPermissionCount = 0;
  try {
    const permData = ensurePermissionSheet_().getDataRange().getValues();
    for (let i = 1; i < permData.length; i++) {
      if (!permData[i][0]) continue;
      const hours = Number(permData[i][5]) || 0;
      if ((permData[i][4] || 'Approved') === 'Approved' && hours > 2 && String(permData[i][1]).trim() === String(name).trim()) longPermissionCount++;
    }
  } catch (err) {}
  return { leaveCount: leaveCount, longPermissionCount: longPermissionCount };
}

