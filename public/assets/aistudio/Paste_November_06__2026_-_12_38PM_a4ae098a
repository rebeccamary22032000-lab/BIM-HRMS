// ---------- HELPERS ----------
function fmtDate_(d) { return Utilities.formatDate(d, TZ, 'yyyy-MM-dd'); }
function fmtTime_(d) { return Utilities.formatDate(d, TZ, 'HH:mm'); }

function fmtHMS_(ms) {
  if (!ms || ms < 0) ms = 0;
  const totalSec = Math.round(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  return [h, m, s].map(n => String(n).padStart(2, '0')).join(':');
}

function parseDurationToMs_(val) {
  if (!val || val === '') return 0;
  if (Object.prototype.toString.call(val) === '[object Date]') {
    return (val.getHours() * 3600 + val.getMinutes() * 60 + val.getSeconds()) * 1000;
  }
  const parts = String(val).split(':').map(Number);
  if (parts.length === 3 && !parts.some(isNaN)) {
    return (parts[0] * 3600 + parts[1] * 60 + parts[2]) * 1000;
  }
  return 0;
}

function sheet_(name) { return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name); }

function normalizeDateCell_(val) {
  if (Object.prototype.toString.call(val) === '[object Date]') return fmtDate_(val);
  return String(val || '').trim();
}

function deriveDiscipline_(designation) {
  const d = String(designation || '').toUpperCase();
  if (d.indexOf('MECHANICAL') !== -1) return 'Mechanical';
  if (d.indexOf('ELECTRICAL') !== -1) return 'Electrical';
  return '';
}

// ============================================================
// SPREADSHEET SIZE CARE (10,000,000 cells per workbook, blanks included)
// ============================================================
function checkWorkbookSize() {
  let total = 0;
  SpreadsheetApp.getActiveSpreadsheet().getSheets().forEach(sh => {
    const cells = sh.getMaxRows() * sh.getMaxColumns();
    total += cells;
    Logger.log(sh.getName() + ': ' + sh.getMaxRows() + ' rows x ' + sh.getMaxColumns() +
      ' cols = ' + cells + ' cells (data rows: ' + sh.getLastRow() + ')');
  });
  Logger.log('TOTAL: ' + total + ' / 10,000,000');
}

function trimWorkbook_() {
  SpreadsheetApp.getActiveSpreadsheet().getSheets().forEach(sh => {
    try {
      const maxR = sh.getMaxRows(), lastR = Math.max(sh.getLastRow(), 1);
      if (maxR - lastR > 50) sh.deleteRows(lastR + 51, maxR - lastR - 50);
      const maxC = sh.getMaxColumns(), lastC = Math.max(sh.getLastColumn(), 1);
      if (maxC - lastC > 2) sh.deleteColumns(lastC + 3, maxC - lastC - 2);
    } catch (e) { Logger.log('trim skipped ' + sh.getName() + ': ' + e.message); }
  });
}

// The ONLY place that calls appendRow. Trims and retries if the workbook is full.
function safeAppend_(sh, rowArray) {
  try {
    sh.appendRow(rowArray);
  } catch (err) {
    try {
      trimWorkbook_();
      SpreadsheetApp.flush();
      sh.appendRow(rowArray);
    } catch (err2) {
      throw new Error('Spreadsheet is full (10M cell limit). Run archiveOldRows() or delete unused tabs. ' + err2.message);
    }
  }
}

// Creates a new tab with only a small grid so it doesn't waste cells.
function createSheet_(name, headers) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh;
  try {
    sh = ss.insertSheet(name);
  } catch (e) {
    trimWorkbook_();
    SpreadsheetApp.flush();
    sh = ss.insertSheet(name);
  }
  sh.appendRow(headers);
  try {
    const mr = sh.getMaxRows();
    if (mr > 200) sh.deleteRows(201, mr - 200);
    const mc = sh.getMaxColumns();
    if (mc > headers.length + 2) sh.deleteColumns(headers.length + 3, mc - headers.length - 2);
  } catch (e) { /* non-fatal */ }
  SpreadsheetApp.flush();
  return sh;
}

function getOrCreateSheet_(name, headers) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  return sh || createSheet_(name, headers);
}

// Run ONCE: keeps duration columns as plain text (stops Sheets turning
// "08:30:00" into a time value, which causes small hour errors).
function fixFormats() {
  const sh = sheet_('TimeLog');
  ['I', 'N', 'O'].forEach(c => sh.getRange(c + ':' + c).setNumberFormat('@'));
  Logger.log('TimeLog duration columns set to plain text.');
}

function archiveOldRows(daysToKeep) {
  daysToKeep = daysToKeep || 60;
  const cutoff = new Date(Date.now() - daysToKeep * 86400000);
  const files = DriveApp.getFilesByName('BIM Bytes Archive');
  const archive = files.hasNext() ? SpreadsheetApp.open(files.next()) : SpreadsheetApp.create('BIM Bytes Archive');

  ['Notifications', 'Messages'].forEach(name => {
    const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
    if (!sh || sh.getLastRow() < 2) return;
    const data = sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).getValues();
    let k = 0;
    while (k < data.length && data[k][0] && new Date(data[k][0]) < cutoff) k++;
    if (!k) return;
    const dest = archive.getSheetByName(name) || archive.insertSheet(name);
    dest.getRange(dest.getLastRow() + 1, 1, k, data[0].length).setValues(data.slice(0, k));
    sh.deleteRows(2, k);
    Logger.log('Archived ' + k + ' rows from ' + name);
  });
}

function setupDailyTriggers() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'nightlyMaintenance') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('nightlyMaintenance').timeBased().everyDays(1).atHour(1).create();
}

function nightlyMaintenance() {
  withLock_(() => autoCloseStaleSessions_(null));
  trimWorkbook_();
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

// ---------- AUTH ----------
function authenticateUser(username, password) {
  const sh = sheet_('Employees');
  if (!sh) return { success: false, message: 'Employees sheet not found.' };
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const empName = row[0], pass = row[1], role = row[2], designation = row[3];
    if (String(empName).trim() === String(username).trim() &&
        String(pass).trim() === String(password).trim()) {
      const photoUrl = row[5] ? String(row[5]).trim() : '';
      return { success: true, name: empName, role: role,
        discipline: deriveDiscipline_(designation), photoUrl: photoUrl };
    }
  }
  return { success: false, message: 'Invalid username or password.' };
}

function changePassword(name, currentPassword, newPassword) {
  if (!newPassword || String(newPassword).trim().length < 4) {
    return { success: false, message: 'New password must be at least 4 characters.' };
  }
  const sh = sheet_('Employees');
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === String(name).trim()) {
      if (String(data[i][1]).trim() !== String(currentPassword).trim()) {
        return { success: false, message: 'Current password is incorrect.' };
      }
      sh.getRange(i + 1, 2).setValue(String(newPassword).trim());
      return { success: true, message: '✔ Password updated.' };
    }
  }
  return { success: false, message: 'Employee not found.' };
}

function getTeamRoster() {
  const sh = sheet_('Employees');
  const data = sh.getDataRange().getValues();
  const roster = [];
  for (let i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    roster.push({
      name: String(data[i][0]).trim(),
      role: data[i][2] || '',
      photoUrl: data[i][5] ? String(data[i][5]).trim() : ''
    });
  }
  return roster;
}

