function postCircular(role, name, title, message, imageUrl, author, thumbnailUrl) {
  if (role !== 'Management') return { success: false, message: 'Not authorized.' };
  if (!title || !String(title).trim()) return { success: false, message: 'Title is required.' };
  if (imageUrl && imageUrl.length > 45000) return { success: false, message: 'Poster image too large even after compression — try a smaller or simpler image.' };
  if (thumbnailUrl && thumbnailUrl.length > 45000) return { success: false, message: 'Thumbnail image too large even after compression.' };
  const sh = ensureCircularsSheet_();
  safeAppend_(sh, [new Date(), name, String(title).trim(), String(message || '').trim(),
    String(imageUrl || '').trim(), String(author || '').trim(), String(thumbnailUrl || '').trim()]);
  return { success: true, message: '✔ Circular posted.' };
}

function getCirculars(limit) {
  limit = limit || 10;
  try {
    const sh = ensureCircularsSheet_();
    const data = sh.getDataRange().getValues();
    const rows = [];
    for (let i = 1; i < data.length; i++) {
      if (!data[i][2]) continue;
      rows.push({
        circularRow: i + 1,
        timestamp: data[i][0] ? fmtDate_(new Date(data[i][0])) : '',
        postedBy: data[i][1], title: data[i][2], message: data[i][3],
        imageUrl: data[i][4], author: data[i][5] || '', thumbnailUrl: data[i][6] || ''
      });
    }
    return rows.reverse().slice(0, limit);
  } catch (err) {
    return { error: 'Could not load circulars: ' + err.message };
  }
}

function editCircular(role, circularRow, title, message, imageUrl, author, thumbnailUrl) {
  if (role !== 'Management') return { success: false, message: 'Not authorized.' };
  if (!title || !String(title).trim()) return { success: false, message: 'Title is required.' };
  if (imageUrl && imageUrl.length > 45000) return { success: false, message: 'Poster image too large even after compression.' };
  if (thumbnailUrl && thumbnailUrl.length > 45000) return { success: false, message: 'Thumbnail image too large even after compression.' };
  const sh = ensureCircularsSheet_();
  sh.getRange(circularRow, 3).setValue(String(title).trim());
  sh.getRange(circularRow, 4).setValue(String(message || '').trim());
  if (imageUrl) sh.getRange(circularRow, 5).setValue(imageUrl);
