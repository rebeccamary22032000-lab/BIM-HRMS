// Open session = RUNNING / ON BREAK **and no EndTime**.
function findOpenRowForUser_(name) {
  const sh = sheet_('TimeLog');
  const last = sh.getLastRow();
  if (last < 2) return null;
  const data = sh.getRange(2, 1, last - 1, 17).getValues();
  for (let i = data.length - 1; i >= 0; i--) {
    const r = data[i];
    if (String(r[1]).trim() === String(name).trim() &&
        (r[9] === 'RUNNING' || r[9] === 'ON BREAK') && !r[7]) {
      return { rowNum: i + 2, row: r };
    }
  }
  return null;
}

// Closes sessions left open on an earlier day. onlyName=null means everyone.
function autoCloseStaleSessions_(onlyName) {
  const sh = sheet_('TimeLog');
  const last = sh.getLastRow();
  if (last < 2) return 0;
  const today = fmtDate_(new Date());
  const data = sh.getRange(2, 1, last - 1, 17).getValues();
  const parts = SHIFT_END.split(':').map(Number);
  const h = parts[0], m = parts[1];
  let closed = 0;

  data.forEach((r, i) => {
    if (r[9] !== 'RUNNING' && r[9] !== 'ON BREAK') return;
    if (onlyName && String(r[1]).trim() !== String(onlyName).trim()) return;

    // Manually edited: EndTime filled but status still RUNNING -> just mark ENDED
    if (r[7]) { sh.getRange(i + 2, 10).setValue('ENDED'); closed++; return; }

    const start = r[6] ? new Date(r[6]) : null;
    if (!start || isNaN(start.getTime())) return;
    if (fmtDate_(start) >= today) return;

    let end = new Date(start.getFullYear(), start.getMonth(), start.getDate(), h, m, 0);
    if (end <= start) end = new Date(start.getTime());

    let breakMs = parseDurationToMs_(r[13]);
    if (r[9] === 'ON BREAK' && r[11]) {
      const bs = new Date(r[11]);
      if (!isNaN(bs.getTime()) && bs < end) breakMs += (end - bs);
    }
    const totalMs = end - start;
    const netMs = Math.max(0, totalMs - breakMs);
    const rowNum = i + 2;

    sh.getRange(rowNum, 8, 1, 4).setValues([[end, fmtHMS_(totalMs), 'ENDED', 'Auto-closed']]);
    sh.getRange(rowNum, 12).setValue('');
    sh.getRange(rowNum, 14).setValue(fmtHMS_(breakMs));
    sh.getRange(rowNum, 15).setValue(fmtHMS_(netMs));
    sh.getRange(rowNum, 16).setValue(((r[15] || '') + ' [Auto-closed: End not tapped]').trim());
    closed++;
  });
  return closed;
}

