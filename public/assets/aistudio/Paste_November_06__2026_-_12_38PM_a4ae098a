    if (!startTime || isNaN(startTime.getTime())) continue;
    sh.getRange(i + 1, 17).setValue(fmtTime_(startTime) <= SHIFT_START ? 'On Time' : 'Late');
    const endTime = row[7] ? new Date(row[7]) : null;
    if (!endTime || isNaN(endTime.getTime())) continue;
    const totalMs = endTime - startTime;
    const breakMs = parseDurationToMs_(row[13]);
    const netMs = Math.max(0, totalMs - breakMs);
    sh.getRange(i + 1, 9).setValue(fmtHMS_(totalMs));
    sh.getRange(i + 1, 15).setValue(fmtHMS_(netMs));
    // keep status consistent for manually edited rows
    if (row[9] === 'RUNNING' || row[9] === 'ON BREAK') sh.getRange(i + 1, 10).setValue('ENDED');
    updated++;
  }
  return { success: true, message: '✔ Recalculated ' + updated + ' completed session(s).' };
}

// ---------- MANUAL ENTRY IMPORT ----------
function combineDateAndTime_(dateVal, timeVal) {
  let year, month, day;
  if (Object.prototype.toString.call(dateVal) === '[object Date]') {
    year = dateVal.getFullYear(); month = dateVal.getMonth(); day = dateVal.getDate();
  } else {
    const d = new Date(dateVal);
    if (isNaN(d.getTime())) return null;
    year = d.getFullYear(); month = d.getMonth(); day = d.getDate();
  }
  let hour = 0, minute = 0, second = 0;
  if (timeVal === '' || timeVal === null || timeVal === undefined) return null;
  if (Object.prototype.toString.call(timeVal) === '[object Date]') {
    hour = timeVal.getHours(); minute = timeVal.getMinutes(); second = timeVal.getSeconds();
  } else {
    const parts = String(timeVal).split(':').map(Number);
    if (parts.length >= 2 && !parts.some(isNaN)) { hour = parts[0]; minute = parts[1]; second = parts[2] || 0; }
    else return null;
  }
  return new Date(year, month, day, hour, minute, second);
}

function importManualEntries(role) {
  if (role !== 'Management') return { success: false, message: 'Not authorized.' };
  const sh = sheet_('ManualEntry');
  if (!sh) return { success: false, message: 'ManualEntry sheet not found.' };
  const data = sh.getDataRange().getValues();
  const timeLogSh = sheet_('TimeLog');
  let imported = 0, skipped = 0;

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (row[10] === 'Yes') continue;
    const [dateVal, name, project, task, subtask, inTimeVal, outTimeVal, breakMinutesVal, endStatus, comment] = row;
    if (!name || !inTimeVal || !outTimeVal) { skipped++; continue; }
    const startTime = combineDateAndTime_(dateVal, inTimeVal);
    const endTime = combineDateAndTime_(dateVal, outTimeVal);
    if (!startTime || !endTime) { skipped++; continue; }

    const totalMs = Math.max(0, endTime - startTime);
    const breakMs = (Number(breakMinutesVal) || 0) * 60000;
    const netMs = Math.max(0, totalMs - breakMs);
    const punctuality = fmtTime_(startTime) <= SHIFT_START ? 'On Time' : 'Late';

    safeAppend_(timeLogSh, [
      fmtDate_(startTime), name, project || 'Manual Entry', task || '', subtask || '', 'Start',
      startTime, endTime, fmtHMS_(totalMs), 'ENDED', endStatus || 'Completed',
      '', '', fmtHMS_(breakMs), fmtHMS_(netMs), (comment || '') + ' [Manual Entry]', punctuality
    ]);
    sh.getRange(i + 1, 11).setValue('Yes');
    imported++;
  }
  return { success: true, message: '✔ Imported ' + imported + ' entr' + (imported === 1 ? 'y' : 'ies') +
    (skipped ? ', skipped ' + skipped + ' incomplete row(s)' : '') };
}

