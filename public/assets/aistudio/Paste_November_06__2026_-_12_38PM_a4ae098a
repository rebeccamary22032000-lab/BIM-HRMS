  safeAppend_(ensureLeaveSheet_(), [dateStr, targetName, String(reason || '').trim(), markedBy, 'Approved']);
  applySandwichLeavePolicy_(targetName);
  logNotification_('LEAVE_MARKED', 'MANAGEMENT', markedBy, '', '', '',
