function searchGiphy(query, type) {
  try {
    const endpoint = (type === 'stickers') ? 'stickers' : 'gifs';
    let url;
    if (query && String(query).trim()) {
      url = 'https://api.giphy.com/v1/' + endpoint + '/search?api_key=' + giphyKey_() +
            '&q=' + encodeURIComponent(String(query).trim()) + '&limit=15&rating=g';
    } else {
      url = 'https://api.giphy.com/v1/' + endpoint + '/trending?api_key=' + giphyKey_() + '&limit=15&rating=g';
    }
    const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    const data = JSON.parse(response.getContentText());
    if (!data || !data.data) return { error: 'No results from GIPHY.' };
    return data.data.map(item => ({
      id: item.id,
      preview: (item.images.fixed_width_small || item.images.fixed_width).url,
      full: item.images.fixed_width.url
    }));
  } catch (err) {
    return { error: 'GIPHY search failed: ' + err.message };
  }
}

function sendMessage(sender, recipient, message, imageUrl) {
  if (!recipient || ((!message || !String(message).trim()) && !imageUrl)) {
    return { success: false, message: 'Recipient and a message or photo are required.' };
  }
  if (imageUrl && imageUrl.length > 45000) return { success: false, message: 'Photo too large even after compression.' };
  safeAppend_(ensureMessagesSheet_(), [new Date(), sender, recipient, String(message || '').trim(), 'No', imageUrl || '', '']);
  logNotification_('NEW_MESSAGE', recipient, sender, '', '', '',
    'New message from ' + sender + (message ? ': ' + String(message).slice(0, 60) : ' (photo)'), '', '');
  return { success: true, message: '✔ Sent.' };
}

function getConversation(name, otherName, limit) {
  limit = limit || 100;
  try {
    const data = ensureMessagesSheet_().getDataRange().getValues();
    const rows = [];
    for (let i = 1; i < data.length; i++) {
      if (data[i][6]) continue;
      const sender = String(data[i][1]).trim(), recipient = String(data[i][2]).trim();
      const between =
        (sender === String(name).trim() && recipient === String(otherName).trim()) ||
        (sender === String(otherName).trim() && recipient === String(name).trim());
      if (!between) continue;
      rows.push({
        sender: data[i][1], message: data[i][3], imageUrl: data[i][5] || '',
        timestamp: data[i][0] ? fmtTime_(new Date(data[i][0])) + ' · ' + fmtDate_(new Date(data[i][0])) : '',
        mine: sender === String(name).trim()
      });
    }
    return rows.slice(-limit);
  } catch (err) {
    return { error: 'Could not load conversation: ' + err.message };
  }
}

function markConversationRead(name, otherName) {
  const sh = ensureMessagesSheet_();
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (!data[i][6] &&
        String(data[i][2]).trim() === String(name).trim() &&
        String(data[i][1]).trim() === String(otherName).trim() &&
        data[i][4] !== 'Yes') {
      sh.getRange(i + 1, 5).setValue('Yes');
    }
  }
  return { success: true };
}

function getConversationList(name) {
  try {
    const data = ensureMessagesSheet_().getDataRange().getValues();
    const convos = {};
    for (let i = 1; i < data.length; i++) {
      if (data[i][6]) continue;
      const sender = String(data[i][1]).trim(), recipient = String(data[i][2]).trim();
      let other = null, incoming = false;
      if (sender === String(name).trim()) other = recipient;
      else if (recipient === String(name).trim()) { other = sender; incoming = true; }
      if (!other) continue;
      if (!convos[other]) convos[other] = { name: other, lastMessage: '', lastTimestamp: '', unread: 0 };
      convos[other].lastMessage = data[i][3] || (data[i][5] ? '📷 Photo' : '');
      convos[other].lastTimestamp = data[i][0] ? fmtTime_(new Date(data[i][0])) + ' · ' + fmtDate_(new Date(data[i][0])) : '';
      if (incoming && data[i][4] !== 'Yes') convos[other].unread++;
    }
    return Object.keys(convos).map(k => convos[k]);
  } catch (err) {
    return { error: 'Could not load conversations: ' + err.message };
  }
