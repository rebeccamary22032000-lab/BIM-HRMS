    const r = data[i];
    if ((r[9] !== 'RUNNING' && r[9] !== 'ON BREAK') || r[7]) continue;
    const startTime = r[6] ? new Date(r[6]) : null;
    if (!startTime || isNaN(startTime.getTime())) continue;
    const hoursElapsed = (now - startTime) / 3600000;
    if (hoursElapsed < thresholdHours) continue;
    rows.push({ name: r[1], project: r[2], taskType: r[3], rowStatus: r[9],
      startedAt: fmtTime_(startTime) + ' · ' + fmtDate_(startTime),
      hoursElapsed: Math.round(hoursElapsed * 10) / 10 });
  }
  return rows.sort((a, b) => b.hoursElapsed - a.hoursElapsed);
}

function getMissedClockIns(role, thresholdHours) {
  if (role !== 'Management') return { error: 'Not authorized.' };
  thresholdHours = thresholdHours || 4;
  const now = new Date();
  const today = fmtDate_(now);
  const [shiftH, shiftM] = SHIFT_START.split(':').map(Number);
  const shiftStartToday = new Date(now.getFullYear(), now.getMonth(), now.getDate(), shiftH, shiftM, 0);
  const hoursSince = (now - shiftStartToday) / 3600000;
  if (hoursSince < thresholdHours) return [];

  const empData = sheet_('Employees').getDataRange().getValues();
  const allNames = [];
  for (let i = 1; i < empData.length; i++) {
    if (empData[i][0] && empData[i][2] !== 'Management') allNames.push(String(empData[i][0]).trim());
  }
  const logData = sheet_('TimeLog').getDataRange().getValues();
  const clockedInToday = new Set();
  for (let i = 1; i < logData.length; i++) {
    if (normalizeDateCell_(logData[i][0]) === today) clockedInToday.add(String(logData[i][1]).trim());
  }
  return allNames.filter(n => !clockedInToday.has(n))
    .map(n => ({ name: n, hoursSinceShiftStart: Math.round(hoursSince * 10) / 10 }));
}

function getNotStartedToday(role) {
  if (role !== 'Management') return { error: 'Not authorized.' };
  const today = fmtDate_(new Date());
  const now = new Date();

  const empData = sheet_('Employees').getDataRange().getValues();
  const allNames = [], weekOffMap = {}, altSaturdayMap = {};
  for (let i = 1; i < empData.length; i++) {
    if (empData[i][0] && empData[i][2] !== 'Management') {
      const nm = String(empData[i][0]).trim();
      allNames.push(nm);
      weekOffMap[nm] = String(empData[i][9] || '').trim();
      altSaturdayMap[nm] = String(empData[i][10] || '').trim();
    }
  }
  const logData = sheet_('TimeLog').getDataRange().getValues();
  const startedToday = new Set();
  for (let i = 1; i < logData.length; i++) {
    if (normalizeDateCell_(logData[i][0]) === today) startedToday.add(String(logData[i][1]).trim());
  }
  const leaveData = ensureLeaveSheet_().getDataRange().getValues();
  const onLeaveToday = new Set();
  for (let i = 1; i < leaveData.length; i++) {
    if (!leaveData[i][0]) continue;
    if ((leaveData[i][4] || 'Approved') !== 'Approved') continue;
    if (normalizeDateCell_(leaveData[i][0]) === today) onLeaveToday.add(String(leaveData[i][1]).trim());
  }
  return allNames
    .filter(n => !startedToday.has(n))
    .filter(n => !isWeekOffDay_(weekOffMap[n], altSaturdayMap[n], now))
    .filter(n => !onLeaveToday.has(n))
    .sort();
}

