// ---------- COMMENT EDIT REQUESTS ----------
function ensureCommentRequestsSheet_() {
  return getOrCreateSheet_('CommentEditRequests',
    ['Timestamp','RequestedBy','RowIndex','Date','Project','TaskType','OldComment','NewComment','Status','ReviewedBy','ReviewedAt']);
}

function updateComment(name, rowIndex, newComment) {
  if (newComment === null || newComment === undefined || String(newComment).trim() === '') {
    return { success: false, message: 'Comment cannot be empty.' };
  }
  const sh = sheet_('TimeLog');
  const row = sh.getRange(rowIndex, 1, 1, 5).getValues()[0];
  if (String(row[1]).trim() !== String(name).trim()) return { success: false, message: 'You can only edit your own entries.' };
  const trimmed = String(newComment).trim();
  sh.getRange(rowIndex, 16).setValue(trimmed);
  logNotification_('COMMENT_UPDATED', 'MANAGEMENT', name, row[2], row[3], row[4],
    name + ' updated the comment for ' + normalizeDateCell_(row[0]) + ' (' + row[2] + ' / ' + row[3] + '): "' + trimmed + '"', '', '');
  return { success: true, message: '✔ Comment updated.' };
}

function requestCommentEdit(name, rowIndex, date, project, taskType, oldComment, newComment) {
  if (newComment === null || newComment === undefined || String(newComment).trim() === '') {
    return { success: false, message: 'Comment cannot be empty.' };
  }
  safeAppend_(ensureCommentRequestsSheet_(),
    [new Date(), name, rowIndex, date, project, taskType, oldComment || '', newComment, 'Pending', '', '']);
  return { success: true, message: '✔ Submitted for approval.' };
}

function getMyCommentRequests(name, limit) {
  limit = limit || 20;
  const data = ensureCommentRequestsSheet_().getDataRange().getValues();
  const rows = [];
  for (let i = 1; i < data.length; i++) {
    if (data[i][1] !== name) continue;
    rows.push({
      date: data[i][3], project: data[i][4], taskType: data[i][5],
      oldComment: data[i][6], newComment: data[i][7], status: data[i][8],
      reviewedBy: data[i][9], reviewedAt: data[i][10] ? fmtDate_(new Date(data[i][10])) : ''
    });
  }
  return rows.reverse().slice(0, limit);
}

function getPendingCommentRequests(role, limit) {
  if (role !== 'Management') return { error: 'Not authorized.' };
  try {
    limit = limit || 50;
    const data = ensureCommentRequestsSheet_().getDataRange().getValues();
    const rows = [], recent = [];
    for (let i = 1; i < data.length; i++) {
      const requestedBy = data[i][1];
      if (!requestedBy) continue;
      const status = String(data[i][8] || '').trim().toLowerCase();
      recent.push(requestedBy + ' — ' + data[i][4] + '/' + data[i][5] + ' — status=[' + data[i][8] + ']');
      if (status !== 'pending') continue;
      rows.push({ requestRow: i + 1, requestedBy: requestedBy, timeLogRow: data[i][2],
        date: data[i][3], project: data[i][4], taskType: data[i][5],
        oldComment: data[i][6], newComment: data[i][7] });
    }
    return { rows: rows.reverse().slice(0, limit), recent: recent.slice(-5).reverse() };
  } catch (err) {
    return { error: 'Could not load pending approvals: ' + err.message };
  }
}

function reviewCommentRequest(role, reviewerName, requestRow, decision) {
  if (role !== 'Management') return { success: false, message: 'Not authorized.' };
  const reqSh = ensureCommentRequestsSheet_();
  const data = reqSh.getDataRange().getValues();
  const row = data[requestRow - 1];
  if (!row || row[8] !== 'Pending') return { success: false, message: 'Request not found or already reviewed.' };
  reqSh.getRange(requestRow, 9).setValue(decision);
  reqSh.getRange(requestRow, 10).setValue(reviewerName);
  reqSh.getRange(requestRow, 11).setValue(new Date());
  if (decision === 'Approved') sheet_('TimeLog').getRange(row[2], 16).setValue(row[7]);
  logNotification_(
    decision === 'Approved' ? 'COMMENT_APPROVED' : 'COMMENT_REJECTED',
    row[1], reviewerName, row[4], row[5], '',
    'Your comment edit on ' + row[4] + ' (' + row[3] + ') was ' + decision.toLowerCase() + ' by ' + reviewerName + '.', '', '');
  return { success: true, message: '✔ Request ' + decision.toLowerCase() + '.' };
}

function getMyNotifications(name, role, limit) {
  try {
    limit = limit || 15;
    const data = ensureNotificationsSheet_().getDataRange().getValues();
    const rows = [];
    for (let i = 1; i < data.length; i++) {
      const target = data[i][2];
      if (data[i][1] === 'START') continue;
      const isMine = target === name;
      const isMgmtBroadcast = (role === 'Management' && target === 'MANAGEMENT');
      if (!isMine && !isMgmtBroadcast) continue;
      const isRead = data[i][9] === 'Yes';
      if (isMgmtBroadcast && isRead) continue;
      let ts = '';
      try {
        if (data[i][0]) { const d = new Date(data[i][0]); if (!isNaN(d.getTime())) ts = fmtTime_(d) + ' · ' + fmtDate_(d); }
      } catch (e) { ts = ''; }
      rows.push({ notifRow: i + 1, timestamp: ts, type: data[i][1], message: data[i][7], dismissable: isMgmtBroadcast });
    }
    return rows.reverse().slice(0, limit);
  } catch (err) {
    return { error: 'Could not load notifications: ' + err.message };
  }
}

function markNotificationRead(notifRow) {
  ensureNotificationsSheet_().getRange(notifRow, 10).setValue('Yes');
  return { success: true };
}