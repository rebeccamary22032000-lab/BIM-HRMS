function saveStart_(d) {
  if (!d.name || !d.project || !d.task || !d.subtask || !d.startStatus) {
    return { status: '⚠ Missing required fields.' };
  }
  autoCloseStaleSessions_(d.name);
  const open = findOpenRowForUser_(d.name);
  if (open) return { status: '⚠ You already have a running session (' + open.row[2] + ') — end it first.' };

  const sh = sheet_('TimeLog');
  const now = new Date();
  const today = fmtDate_(now);
  const clockInStr = fmtTime_(now);

  let punctuality = '—';
  if (!hasAnyStartToday_(d.name, today)) {
    punctuality = clockInStr <= SHIFT_START ? 'On Time' : 'Late';
  }

  safeAppend_(sh, [
    today, d.name, d.project, d.task, d.subtask, d.startStatus,
    now, '', '', 'RUNNING', '', '', '', '00:00:00', '', d.comment || '', punctuality
  ]);

  logNotification_('START', 'TEAM', d.name, d.project, d.task, d.subtask,
    d.name + ' started ' + d.task + ' on ' + d.project + ' at ' + clockInStr +
      (punctuality !== '—' ? ' (' + punctuality + ')' : ''));

  return { status: '✔ Started' + (punctuality !== '—' ? ' — ' + punctuality : '') };
}

function saveEnd_(d) {
  if (!d.name || !d.endStatus) return { status: '⚠ Select End Status.' };
  const found = findOpenRowForUser_(d.name);
  if (!found) return { status: '⚠ No active session found.' };

  const sh = sheet_('TimeLog');
  const row = found.row;
  const startTime = new Date(row[6]);
  const endTime = new Date();
  const totalMs = isNaN(startTime.getTime()) ? 0 : (endTime - startTime);
  let breakTotalMs = parseDurationToMs_(row[13]);
  if (row[9] === 'ON BREAK' && row[11]) {
    const bs = new Date(row[11]);
    if (!isNaN(bs.getTime())) breakTotalMs += (endTime - bs);
  }
  const netMs = Math.max(0, totalMs - breakTotalMs);

  const existingComment = row[15] || '';
  const endComment = d.comment ? String(d.comment).trim() : '';
  const finalComment = endComment
    ? (existingComment ? existingComment + ' | End: ' + endComment : endComment)
    : existingComment;

  const n = found.rowNum;
  sh.getRange(n, 8).setValue(endTime);
  sh.getRange(n, 9).setValue(fmtHMS_(totalMs));
  sh.getRange(n, 10).setValue('ENDED');
  sh.getRange(n, 11).setValue(d.endStatus);
  sh.getRange(n, 12).setValue('');
  sh.getRange(n, 14).setValue(fmtHMS_(breakTotalMs));
  sh.getRange(n, 15).setValue(fmtHMS_(netMs));
  sh.getRange(n, 16).setValue(finalComment);

  return { status: '✔ Session ended', total: fmtHMS_(totalMs), net: fmtHMS_(netMs), brk: fmtHMS_(breakTotalMs) };
}

function saveBreakStart_(d) {
  if (!d.name) return { status: '⚠ Not logged in.' };
  const found = findOpenRowForUser_(d.name);
  if (!found || found.row[9] !== 'RUNNING') return { status: '⚠ Start work first.' };
  const sh = sheet_('TimeLog');
  sh.getRange(found.rowNum, 10).setValue('ON BREAK');
  sh.getRange(found.rowNum, 12).setValue(new Date());
  return { status: '☕ Break started' };
}

function saveBreakEnd_(d) {
  if (!d.name) return { status: '⚠ Not logged in.' };
  const found = findOpenRowForUser_(d.name);
  if (!found || found.row[9] !== 'ON BREAK') return { status: '⚠ No active break found.' };
  const sh = sheet_('TimeLog');
  const breakStart = new Date(found.row[11]);
  const breakEnd = new Date();
  const thisBreakMs = isNaN(breakStart.getTime()) ? 0 : (breakEnd - breakStart);
  const newTotalBreakMs = parseDurationToMs_(found.row[13]) + thisBreakMs;

  sh.getRange(found.rowNum, 10).setValue('RUNNING');
  sh.getRange(found.rowNum, 12).setValue('');
  sh.getRange(found.rowNum, 13).setValue(breakEnd);
  sh.getRange(found.rowNum, 14).setValue(fmtHMS_(newTotalBreakMs));

  return { status: '▶ Break ended — resuming work', breakMs: thisBreakMs };
}

