function isWeekOffDay_(weekOffCsv, altSaturdayPattern, date) {
  const dowNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const dow = dowNames[date.getDay()];
  const weekOffDays = String(weekOffCsv || '').split(',').map(s => s.trim()).filter(Boolean);
  if (weekOffDays.indexOf(dow) !== -1) return true;
  if (dow === 'Saturday' && altSaturdayPattern) {
    const nth = Math.ceil(date.getDate() / 7);
    if (altSaturdayPattern === '2nd4th' && (nth === 2 || nth === 4)) return true;
    if (altSaturdayPattern === '1st3rd' && (nth === 1 || nth === 3)) return true;
  }
  return false;
}

