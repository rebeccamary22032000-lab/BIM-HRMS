  // ============== LOGIN ==============
  function populateUsernames() {
    google.script.run.withSuccessHandler(users => {
      const sel = document.getElementById('loginUser');
      sel.innerHTML = '<option value="">Select Username</option>';
      users.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.username;
        opt.textContent = u.username;
        sel.appendChild(opt);
      });
    }).getUsernames();
  }
  populateUsernames();

  function togglePasswordVisibility() {
    const pass = document.getElementById('loginPass');
    const icon = document.getElementById('togglePassIcon');
    if (pass.type === 'password') { pass.type = 'text'; icon.textContent = '🙈'; }
    else { pass.type = 'password'; icon.textContent = '👁'; }
  }

  function doLogin() {
    const username = document.getElementById('loginUser').value.trim();
    const password = document.getElementById('loginPass').value;
    const msg = document.getElementById('loginMsg');
    msg.textContent = '';
    if (!username || !password) { msg.textContent = 'Please enter both username and password.'; return; }

    google.script.run
      .withSuccessHandler(res => {
        if (res.success) {
          currentUser = { name: res.name, role: res.role, discipline: res.discipline, photoUrl: res.photoUrl || '' };
          discipline = res.discipline === 'Electrical' ? 'elec' : 'mech';
          enterMenu();
        } else {
          msg.textContent = res.message || 'Login failed.';
        }
      })
      .withFailureHandler(e => { msg.textContent = 'Error: ' + e.message; })
      .authenticateUser(username, password);
  }

  function hideAllScreens(){
    ['menuScreen','timeScreen','qcScreen','perfScreen','dashScreen','adminScreen','settingsScreen','memosScreen','messagesScreen']
      .forEach(id => document.getElementById(id).classList.add('hidden'));
  }

  function enterMenu() {
    document.getElementById('loginCard').classList.add('hidden');
    document.getElementById('appShell').classList.remove('hidden');
    hideAllScreens();
    document.getElementById('menuScreen').classList.remove('hidden');

    document.getElementById('sbName').textContent = currentUser.name;
    document.getElementById('sbRole').textContent = currentUser.role.toUpperCase();
    const sbAvatar = document.getElementById('sbAvatar');
    if (currentUser.photoUrl) {
      sbAvatar.innerHTML = '<img src="' + currentUser.photoUrl + '" alt="' + currentUser.name + '">';
    } else {
      sbAvatar.textContent = currentUser.name.trim().charAt(0).toUpperCase();
    }
    document.getElementById('topbarName').textContent = currentUser.name.split(' ')[0].toUpperCase();

    const isMgmt = currentUser.role === 'Management';
    document.getElementById('teamRosterSection').classList.toggle('hidden', !isMgmt);
    document.getElementById('mgmtPostCircular').classList.toggle('hidden', !isMgmt);
    document.getElementById('soaButtonWrap').classList.toggle('hidden', !isMgmt);
    document.getElementById('mgmtAddHoliday').classList.toggle('hidden', !isMgmt);
    if (isMgmt) loadTeamRoster();
    loadCirculars();
    loadHolidays();
    loadHomeMyWork();
    loadMyRequests();

    document.getElementById('qcMenuBtn').classList.toggle('hidden',
      !(currentUser.role === 'QC' || currentUser.role === 'Management'));
    document.getElementById('dashMenuLabel').textContent =
      currentUser.role === 'Management' ? 'Dashboard' : 'My Dashboard';
    document.getElementById('teamActivitySection').classList.toggle('hidden', !isMgmt);
    document.getElementById('notStartedSection').classList.toggle('hidden', !isMgmt);
    if (isMgmt) { loadTeamActivity(); loadNotStartedToday(); }
    loadMyNotifications();
    checkQCAlertBanner();
    checkMemoBanner();
    checkMessagesBadge();
    loadHomeRings();

    document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
    const homeNav = document.querySelector('.sidebar-nav .nav-item');
    if (homeNav) homeNav.classList.add('active');
  }

  function navSelect(el){
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    if (el) el.classList.add('active');
  }

  function renderRing(containerId, percent, color){
    const pct = Math.max(0, Math.min(100, Math.round(percent || 0)));
    const r = 36, circ = 2 * Math.PI * r;
    const dash = (pct / 100) * circ;
    const el = document.getElementById(containerId);
    if (!el) return;
    el.innerHTML =
      '<svg width="84" height="84" viewBox="0 0 84 84">' +
        '<circle cx="42" cy="42" r="' + r + '" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="7"/>' +
        '<circle cx="42" cy="42" r="' + r + '" fill="none" stroke="' + color + '" stroke-width="7" ' +
          'stroke-dasharray="' + dash + ' ' + (circ - dash) + '" stroke-linecap="round" ' +
          'transform="rotate(-90 42 42)"/>' +
      '</svg>' +
      '<div class="ring-value">' + pct + '%</div>';
  }

  function loadHomeRings(){
    google.script.run.withSuccessHandler(res=>{
      renderRing('ringPunctuality', res.punctualityPct, '#ff5566');
      renderRing('ringProductivity', res.productivityPct, '#42a5f5');
      renderRing('ringScore', res.performanceScore, '#ffaa00');
    }).getMyPerformanceScore(currentUser.name);
  }

  function checkQCAlertBanner(){
    google.script.run.withSuccessHandler(count=>{
      const banner = document.getElementById('qcAlertBanner');
      if(count > 0){
        document.getElementById('qcAlertCount').textContent = count;
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }).countUnreadQCAlerts(currentUser.name);
  }

  function loadNotStartedToday(){
    const el = document.getElementById('notStartedList');
    el.textContent = 'Loading…';
    google.script.run.withSuccessHandler(names=>{
      if(names && names.error){ el.textContent = 'Error: ' + names.error; return; }
      if(!names || !names.length){ el.innerHTML = '<span style="color:#00e676;">✔ Everyone has started today.</span>'; return; }
      el.innerHTML = `<div style="margin-bottom:6px; color:#ffaa00;">${names.length} not started yet — could be running late or on leave:</div>` +
        names.map(n => `<div>• ${n}</div>`).join('');
    }).withFailureHandler(e=>{
      el.textContent = 'Could not load: ' + e.message;
    }).getNotStartedToday(currentUser.role);
  }

  function loadTeamActivity(){
    google.script.run.withSuccessHandler(rows=>{
      const el = document.getElementById('teamActivityFeed');
      if(!rows || !rows.length){ el.textContent = 'No recent activity.'; return; }
      el.innerHTML = rows.map(r =>
        `<div style="padding:4px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
           <span style="color:#666;">${r.timestamp}</span> — ${r.message}
         </div>`
      ).join('');
    }).withFailureHandler(()=>{
      document.getElementById('teamActivityFeed').textContent = 'Could not load activity.';
    }).getTeamActivityFeed(15);
  }

  function loadMyNotifications(){
    const el = document.getElementById('myNotificationsFeed');
    el.textContent = 'Loading…';
    google.script.run.withSuccessHandler(rows=>{
      if(rows && rows.error){ el.textContent = 'Error: ' + rows.error; return; }
      if(!rows || !rows.length){ el.textContent = 'No notifications yet.'; return; }
      el.innerHTML = rows.map(r => `
        <div style="padding:4px 0; border-bottom:1px solid rgba(255,255,255,0.06); display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
          <div><span style="color:#666;">${r.timestamp}</span> — ${r.message}</div>
          ${r.dismissable ? `<span style="flex-shrink:0; color:#00e676; text-decoration:underline; cursor:pointer; font-size:11px; white-space:nowrap;" onclick="dismissNotification(${r.notifRow})">✔ Verified</span>` : ''}
        </div>
      `).join('');
    }).withFailureHandler(e=>{
      el.innerHTML = 'Could not load notifications: ' + e.message +
        ' <span style="text-decoration:underline; cursor:pointer;" onclick="loadMyNotifications()">Retry</span>';
    }).getMyNotifications(currentUser.name, currentUser.role, 15);
  }

  function dismissNotification(notifRow){
    google.script.run.withSuccessHandler(()=>{
      loadMyNotifications();
    }).withFailureHandler(e=>alert('Error: '+e.message))
      .markNotificationRead(notifRow);
  }

  // FIX: also stops timers so a clock never leaks between logins
  function logout() {
    resetTimerState();
    currentUser = null;
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    document.getElementById('appShell').classList.add('hidden');
    hideAllScreens();
    document.getElementById('loginCard').classList.remove('hidden');
  }

  function backToMenu() {
    hideAllScreens();
    document.getElementById('menuScreen').classList.remove('hidden');
    document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
    const homeNav = document.querySelector('.sidebar-nav .nav-item');
    if (homeNav) homeNav.classList.add('active');
