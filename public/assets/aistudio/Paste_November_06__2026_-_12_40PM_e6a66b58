  function submitPhotoUpload(){
    const fileInput = document.getElementById('photoFile');
    if (!fileInput.files[0]) { setMsg('photoMsg','Choose a photo first.','warn'); return; }
    openImageCropper(fileInput, croppedDataUrl=>{
      if (!croppedDataUrl) return;
      setMsg('photoMsg','Uploading…','warn');
      compressDataUrlToFit(croppedDataUrl, (dataUrl, err)=>{
        if (err) { setMsg('photoMsg', err, 'error'); return; }
        google.script.run.withSuccessHandler(res=>{
          setMsg('photoMsg', res.message, res.success ? 'success' : 'error');
          if (res.success) {
            currentUser.photoUrl = dataUrl;
            document.getElementById('settingsPhotoPreview').innerHTML = '<img src="' + dataUrl + '" style="width:100%; height:100%; object-fit:cover;">';
            document.getElementById('sbAvatar').innerHTML = '<img src="' + dataUrl + '" alt="">';
            fileInput.value = '';
          }
        }).withFailureHandler(e=>setMsg('photoMsg','Error: '+e.message,'error'))
          .uploadMyPhoto(currentUser.name, dataUrl);
