          <div onclick="openGroupConversation('${g.groupId}', '${g.groupName.replace(/'/g,"\\'")}')" style="display:flex; align-items:center; gap:8px; padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.06); cursor:pointer;">
