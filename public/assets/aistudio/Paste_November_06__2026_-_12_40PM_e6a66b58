  function submitMgmtEmployeeFields(){
    const target = document.getElementById('mgmtEmpSelect').value;
    const joiningDate = document.getElementById('mgmtJoiningDate').value;
    const emergencyContact = document.getElementById('mgmtEmergencyContact').value.trim();
    const contactPersonName = document.getElementById('mgmtContactPersonName').value.trim();
    const contactRelation = document.getElementById('mgmtContactRelation').value.trim();
    const offDays = [];
    if (document.getElementById('weekOffSunday').checked) offDays.push('Sunday');
    if (document.getElementById('weekOffSaturday').checked) offDays.push('Saturday');
    const weekOff = offDays.join(',');
    const altSaturday = document.getElementById('mgmtAltSaturday').value;
    setMsg('mgmtEmpMsg','Saving…','warn');
    google.script.run.withSuccessHandler(res=>{
      setMsg('mgmtEmpMsg', res.message, res.success ? 'success' : 'error');
    }).withFailureHandler(e=>setMsg('mgmtEmpMsg','Error: '+e.message,'error'))
      .updateEmployeeManagedFields(currentUser.role, target, joiningDate, emergencyContact, weekOff, altSaturday, contactPersonName, contactRelation);
  }

