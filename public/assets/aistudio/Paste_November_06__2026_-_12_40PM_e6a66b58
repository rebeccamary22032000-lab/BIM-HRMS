          (r.errorCount>0 ? `onclick="showQCAlertsForEmployee('${nameEsc}')"` : '') +
          '>'+r.errorCount+'</td></tr>';
      });
    }).getAllPerformanceScores(currentUser.role);
  }

  function showQCAlertsForEmployee(name){
    google.script.run.withSuccessHandler(rows=>{
      if(rows.error){ alert(rows.error); return; }
      const table = document.querySelector('#perfQCAlertsTable');
      const empty = document.getElementById('perfQCAlertsEmpty');
      const tbody = document.querySelector('#perfQCAlertsTable tbody');
      const scopeLabel = document.getElementById('qcAlertsScopeLabel');
      scopeLabel.classList.remove('hidden');
      document.getElementById('qcAlertsScopeName').textContent = name;

      if(!rows.length){ table.classList.add('hidden'); empty.classList.remove('hidden'); }
      else {
        table.classList.remove('hidden'); empty.classList.add('hidden');
        tbody.innerHTML = rows.map(r =>
          `<tr><td>${r.date}</td><td>${r.project}</td><td>${r.taskType}${r.subTask && r.subTask!=='—' ? ' / '+r.subTask : ''}</td>
           <td>${r.errorCount}</td><td>${r.message}</td></tr>`
        ).join('');
      }
      scrollToQCDetail();
    }).getQCAlertsFor(currentUser.role, name);
  }

  // ============== QC ==============
  function showQC(){
    if(currentUser.role !== 'QC' && currentUser.role !== 'Management') return;
    hideAllScreens();
    document.getElementById('qcScreen').classList.remove('hidden');
    document.getElementById('qcReviewerName').textContent = currentUser.name;
    document.getElementById('qcMsg').textContent = '';
    document.getElementById('previewBox').classList.remove('visible');

    const isMgmt = currentUser.role === 'Management';
    document.getElementById('btnMech').disabled = !isMgmt;
    document.getElementById('btnElec').disabled = !isMgmt;
    document.getElementById('gateNote').innerHTML = isMgmt
      ? 'Access: <b>QC staff and Management only</b>. As Management you can toggle either discipline.'
      : 'Access: <b>QC staff and Management only</b>. You are assigned to <b>' + (discipline==='mech'?'Mechanical':'Electrical') + '</b> QC.';

    populateEmployees();
    setDiscipline(discipline);
    loadQCLogs();
  }

  function populateEmployees(){
    google.script.run.withSuccessHandler(names=>{
      const sel = document.getElementById('empName');
      sel.innerHTML = '';
      names.forEach(n=>{
        const opt = document.createElement('option');
        opt.value = n; opt.textContent = n;
        sel.appendChild(opt);
      });
    }).getProductionStaff();
  }

  function setDiscipline(d){
    const isMgmt = currentUser.role === 'Management';
    if (!isMgmt && d !== discipline) return;
    discipline = d;
    document.getElementById('btnMech').classList.toggle('active', d==='mech');
    document.getElementById('btnElec').classList.toggle('active', d==='elec');
    populateWorkTypes();
    document.getElementById('previewBox').classList.remove('visible');
  }

  function populateWorkTypes(){
    const map = discipline==='mech' ? MECH_MAP : ELEC_MAP;
    const sel = document.getElementById('workType');
    sel.innerHTML = '';
    Object.keys(map).forEach(wt=>{
      const opt = document.createElement('option');
      opt.value = wt; opt.textContent = wt;
      sel.appendChild(opt);
    });
    onWorkTypeChange();
  }

  function onWorkTypeChange(){
    const map = discipline==='mech' ? MECH_MAP : ELEC_MAP;
    const wt = document.getElementById('workType').value;
    const subtasks = map[wt];
    const wrap = document.getElementById('subtaskWrap');
    const note = document.getElementById('noSubtaskNote');
    const sel = document.getElementById('subTask');
    if(subtasks){
      wrap.classList.add('visible'); note.classList.remove('visible');
      sel.innerHTML = '';
      subtasks.forEach(st=>{
        const opt = document.createElement('option');
        opt.value = st; opt.textContent = st;
        sel.appendChild(opt);
      });
    } else {
      wrap.classList.remove('visible'); note.classList.add('visible');
    }
  }

  function submitError(){
    const map = discipline==='mech' ? MECH_MAP : ELEC_MAP;
    const wt = document.getElementById('workType').value;
    const hasSub = !!map[wt];
    const st = hasSub ? document.getElementById('subTask').value : '—';
    const comment = document.getElementById('qcComment').value;
    const emp = document.getElementById('empName').value;
    const proj = document.getElementById('qcProject').value;
    const errCount = document.getElementById('errorCount').value || '1';
    const disciplineLabel = discipline==='mech' ? 'Mechanical' : 'Electrical';

    if(!emp || !wt || !proj){ setMsg('qcMsg','Select employee, project, and work type','warn'); return; }

    setMsg('qcMsg','Submitting...','warn');
    google.script.run.withSuccessHandler(res=>{
      if(!res.success){ setMsg('qcMsg',res.message||'Submission failed.','error'); return; }
      setMsg('qcMsg','✔ Error logged','success');
      document.getElementById('prevEmp').textContent = emp;
      document.getElementById('prevDiscipline').textContent = disciplineLabel;
      document.getElementById('prevWorkType').textContent = wt;
      document.getElementById('prevSubTask').textContent = st;
      document.getElementById('prevErrorCount').textContent = errCount;
      document.getElementById('previewBox').classList.add('visible');
      document.getElementById('qcComment').value = '';
      loadQCLogs();
    }).withFailureHandler(e=>setMsg('qcMsg','Error: '+e.message,'error'))
      .submitQCError({
        reviewerName: currentUser.name, reviewerRole: currentUser.role,
        markedFor: emp, discipline: disciplineLabel, workType: wt,
        subTask: st, errorCount: errCount, comment: comment, project: proj
      });
  }

  function loadQCLogs(){
    google.script.run.withSuccessHandler(rows=>{
      if(rows.error) return;
      const tbody = document.querySelector('#qcTable tbody');
      tbody.innerHTML = '';
      rows.slice(0,30).forEach(r=>{
        tbody.innerHTML += '<tr><td>'+r.markedFor+'</td><td>'+(r.project||'—')+'</td><td>'+r.workType+'</td><td>'+
          r.errorCount+'</td><td>'+r.date+'</td></tr>';
      });
    }).getQCLogs(currentUser.role);
  }

  // ============== DASHBOARD ==============
  let dashRows = [];
  let dashFiltered = [];
  let dashCurrentProject = null;
  let dashCurrentPerson = null;

  function showDashboard(){
    hideAllScreens();
    document.getElementById('dashScreen').classList.remove('hidden');
    document.getElementById('dashName').textContent = currentUser.name;
    document.getElementById('dashRole').textContent = currentUser.role.toUpperCase();
    document.getElementById('dashProjectPicker').classList.add('hidden');
    document.getElementById('dashProjectDetail').classList.add('hidden');
    document.getElementById('dashPersonDetail').classList.add('hidden');
    document.getElementById('dashKpiBox').classList.remove('hidden');
    document.getElementById('dashExportBtn').classList.toggle('hidden', currentUser.role !== 'Management');

    google.script.run.withSuccessHandler(rows=>{
      if(rows.error){ alert(rows.error); backToMenu(); return; }
      dashRows = rows;
      if(dashRows.length){
        const dates = dashRows.map(r=>r.date).sort();
        document.getElementById('dashFrom').value = dates[0];
        document.getElementById('dashTo').value = dates[dates.length-1];
        document.getElementById('dashFrom').min = dates[0];
        document.getElementById('dashFrom').max = dates[dates.length-1];
        document.getElementById('dashTo').min = dates[0];
        document.getElementById('dashTo').max = dates[dates.length-1];
      }
      dashApplyFilter();
    }).withFailureHandler(e=>{
      alert('Error loading dashboard: '+e.message);
      backToMenu();
    }).getDashboardData(currentUser.role, currentUser.name);
  }

  document.getElementById('dashFrom')?.addEventListener('change', dashApplyFilter);
  document.getElementById('dashTo')?.addEventListener('change', dashApplyFilter);
  document.getElementById('dashActiveProjectsRow')?.addEventListener('click', dashToggleProjectPicker);

  function dashQuickRange(days){
    if(!dashRows.length) return;
    const maxDate = dashRows.map(r=>r.date).sort().slice(-1)[0];
    const end = new Date(maxDate+'T00:00:00');
    const start = new Date(end); start.setDate(start.getDate()-(days-1));
    document.getElementById('dashFrom').value = start.toISOString().slice(0,10);
    document.getElementById('dashTo').value = end.toISOString().slice(0,10);
    dashApplyFilter();
  }
  function dashResetRange(){
    if(!dashRows.length) return;
    const dates = dashRows.map(r=>r.date).sort();
    document.getElementById('dashFrom').value = dates[0];
    document.getElementById('dashTo').value = dates[dates.length-1];
    dashApplyFilter();
  }

  function dashFmtHM(ms){
    if(!ms || ms < 0) ms = 0;
    const totalMin = Math.round(ms / 60000);
    const h = Math.floor(totalMin / 60);
    const m = totalMin % 60;
    return h + ':' + String(m).padStart(2,'0');
  }

  function dashApplyFilter(){
    let from = document.getElementById('dashFrom').value;
    let to = document.getElementById('dashTo').value;
    if(from > to){ [from,to] = [to,from]; }
    dashFiltered = dashRows.filter(r => r.date >= from && r.date <= to);

    const totalMs = dashFiltered.reduce((s,r)=>s+r.netMs,0);
    const people = new Set(dashFiltered.map(r=>r.name));
    const projects = new Set(dashFiltered.map(r=>r.project));

    document.getElementById('dashTotalHours').textContent = dashFmtHM(totalMs);
    document.getElementById('dashTotalEntries').textContent = dashFiltered.length;
    document.getElementById('dashActiveProjects').textContent = projects.size;
    document.getElementById('dashActivePeople').textContent = people.size;

    if(dashCurrentProject) dashShowProject(dashCurrentProject);
    if(dashCurrentPerson) dashShowPerson(dashCurrentPerson);
  }

  function dashToggleProjectPicker(){
    const picker = document.getElementById('dashProjectPicker');
    const isHidden = picker.classList.contains('hidden');
    document.getElementById('dashProjectDetail').classList.add('hidden');
    document.getElementById('dashPersonDetail').classList.add('hidden');
    if(!isHidden){ picker.classList.add('hidden'); return; }

    const isMgmt = currentUser.role === 'Management';
    const byProject = {};
    dashFiltered.forEach(r=>{
      byProject[r.project] = byProject[r.project] || {ms:0, entries:0};
      byProject[r.project].ms += r.netMs;
      byProject[r.project].entries += 1;
    });
    const names = Object.keys(byProject).sort((a,b)=>byProject[b].ms - byProject[a].ms);

    const grid = document.getElementById('dashProjectGrid');
    grid.innerHTML = names.map(n =>
      `<div class="menu-btn" style="padding:18px 10px;" onclick="dashShowProject('${n.replace(/'/g,"\\'")}')">
         <span style="font-size:14px; display:block;${isMgmt?' margin-bottom:4px;':''}">${n}</span>
         ${isMgmt ? `<span style="font-size:12px; color:#666; font-weight:600;">${dashFmtHM(byProject[n].ms)} · ${byProject[n].entries} entries</span>` : ''}
       </div>`
    ).join('') || '<div style="grid-column:1/-1; text-align:center; color:#888; padding:20px;">No projects in this date range.</div>';

    picker.classList.remove('hidden');
  }

  function dashShowProject(projectName){
    dashCurrentProject = projectName;
    document.getElementById('dashProjectPicker').classList.add('hidden');
    document.getElementById('dashPersonDetail').classList.add('hidden');
    document.getElementById('dashProjectDetail').classList.remove('hidden');
    document.getElementById('dashProjectDetailTitle').textContent = projectName;

    const isMgmt = currentUser.role === 'Management';
    const rows = dashFiltered.filter(r => r.project === projectName);

    const byPerson = {};
    rows.forEach(r=>{
      byPerson[r.name] = byPerson[r.name] || {ms:0, entries:0};
      byPerson[r.name].ms += r.netMs;
      byPerson[r.name].entries += 1;
    });
    const personNames = Object.keys(byPerson).sort((a,b)=>byPerson[b].ms - byPerson[a].ms);

    document.getElementById('dpEmployeeGroups').innerHTML = personNames.map(n =>
      `<div class="menu-btn" style="padding:18px 10px;" onclick="dashShowPerson('${n.replace(/'/g,"\\'")}')">
         <span style="font-size:14px; display:block;${isMgmt?' margin-bottom:4px;':''}">${n}</span>
         ${isMgmt ? `<span style="font-size:12px; color:#666; font-weight:600;">${dashFmtHM(byPerson[n].ms)} · ${byPerson[n].entries} entries</span>` : ''}
       </div>`
    ).join('') || '<div style="grid-column:1/-1; text-align:center; color:#888; padding:20px;">No entries for this project in this date range.</div>';
  }

  function dashShowPerson(name){
    dashCurrentPerson = name;
    document.getElementById('dashProjectDetail').classList.add('hidden');
    document.getElementById('dashPersonDetail').classList.remove('hidden');
    document.getElementById('dashPersonDetailTitle').textContent = name + ' — ' + dashCurrentProject;

    const isMgmt = currentUser.role === 'Management';
    const rows = dashFiltered.filter(r => r.project === dashCurrentProject && r.name === name);
    const totalMs = rows.reduce((s,r)=>s+r.netMs,0);
    const onTime = rows.filter(r=>r.punctuality==='On Time').length;
    const late = rows.filter(r=>r.punctuality==='Late').length;

    document.getElementById('dpxHours').textContent = dashFmtHM(totalMs);
    document.getElementById('dpxSessions').textContent = rows.length;
    document.getElementById('dpxPunct').textContent = onTime + ' / ' + late;

    const esc = s => String(s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');

    const tbody = document.querySelector('#dpxTable tbody');
    tbody.innerHTML = rows.slice().reverse().map(r => {
      const verifiedCell = r.verifiedBy
        ? `✅ <span style="font-size:10px; color:#666;">${r.verifiedBy}</span>`
        : (isMgmt
            ? `<span style="text-decoration:underline; cursor:pointer; color:#42a5f5;" onclick="dashVerifyRow(${r.rowIndex})">Approve</span>`
            : '—');
      const commentCell = `${r.comments || '<span style="color:#555;">—</span>'} ` +
        (!isMgmt
          ? `<span style="cursor:pointer;" title="Edit comment" onclick="dashEditComment(${r.rowIndex}, '${esc(r.comments)}', '${esc(r.date)}', '${esc(r.project)}', '${esc(r.taskType)}')">✏️</span>`
          : '');
      return `<tr><td>${r.date}</td><td>${r.taskType}</td><td>${r.subTask||'-'}</td><td>${dashFmtHM(r.netMs)}</td>
         <td>${r.endStatus||r.rowStatus||'-'}</td><td>${commentCell}</td><td>${verifiedCell}</td></tr>`;
    }).join('');
  }

  function dashVerifyRow(rowIndex){
    google.script.run.withSuccessHandler(res=>{
      if(!res.success){ alert(res.message||'Could not verify.'); return; }
      dashShowPerson(dashCurrentPerson);
    }).withFailureHandler(e=>alert('Error: '+e.message))
      .verifyEntry(currentUser.role, currentUser.name, rowIndex);
  }

  function dashEditComment(rowIndex, oldComment, date, project, taskType){
    const newComment = prompt('Edit comment for ' + date + ' — ' + project + ' / ' + taskType + ':', oldComment || '');
    if(newComment === null) return;
    if(newComment.trim() === ''){ alert('Comment cannot be empty.'); return; }
    google.script.run.withSuccessHandler(res=>{
      if(!res.success){ alert(res.message || 'Could not update.'); return; }
      const trimmed = newComment.trim();
      dashRows.forEach(r=>{ if(r.rowIndex === rowIndex) r.comments = trimmed; });
      dashFiltered.forEach(r=>{ if(r.rowIndex === rowIndex) r.comments = trimmed; });
      dashShowPerson(dashCurrentPerson);
    }).withFailureHandler(e=>alert('Error: '+e.message))
      .updateComment(currentUser.name, rowIndex, newComment.trim());
  }

  function dashBackToPicker(){
    dashCurrentProject = null;
    document.getElementById('dashProjectDetail').classList.add('hidden');
    document.getElementById('dashProjectPicker').classList.add('hidden');
    dashToggleProjectPicker();
  }
  function dashBackToProject(){
    dashCurrentPerson = null;
    document.getElementById('dashPersonDetail').classList.add('hidden');
    dashShowProject(dashCurrentProject);
  }

  function dashExportCSV(){
    if(!dashFiltered.length){ alert('Nothing to export in this date range.'); return; }
    const headers = ['Date','Name','Project','Task Type','Sub Task','Net Hours (HH:MM)','Punctuality','End Status'];
    const escapeCsv = v => {
      v = (v===undefined || v===null) ? '' : String(v);
      return /[",\n]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v;
    };
    const lines = [headers.map(escapeCsv).join(',')];
    dashFiltered.forEach(r=>{
      lines.push([
        r.date, r.name, r.project, r.taskType, r.subTask || '',
        dashFmtHM(r.netMs), r.punctuality || '', r.endStatus || r.rowStatus || ''
      ].map(escapeCsv).join(','));
    });
    const csv = lines.join('\n');
    const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
    const url = URL.createObjectURL(blob);
    const from = document.getElementById('dashFrom').value;
    const to = document.getElementById('dashTo').value;
    const a = document.createElement('a');
    a.href = url;
    a.download = 'BIMBytes_TimeLog_' + from + '_to_' + to + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // FIX: re-sync with the server when the tab is reopened or the day changes
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && currentUser && !document.getElementById('timeScreen').classList.contains('hidden')) restoreActiveSession();
  });
  setInterval(() => {
    if (currentUser && workStartTS && new Date(workStartTS).toDateString() !== new Date().toDateString()) restoreActiveSession();
  }, 300000);

  setBtns('idle');
</script>

