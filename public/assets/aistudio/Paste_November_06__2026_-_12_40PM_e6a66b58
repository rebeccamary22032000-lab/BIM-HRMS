    google.script.run.withSuccessHandler(profile=>{
      document.getElementById('profileJoiningDate').textContent = profile.joiningDate || '—';
      document.getElementById('profileEmergencyContact').textContent = profile.emergencyContact || '—';
      document.getElementById('profileContactPersonName').textContent = profile.contactPersonName || '—';
      document.getElementById('profileContactRelation').textContent = profile.contactRelation || '—';
      document.getElementById('myAddress').value = profile.address || '';
    }).getMyProfile(currentUser.name);

    const isMgmt = currentUser.role === 'Management';
    document.getElementById('mgmtSettingsWrap').classList.toggle('hidden', !isMgmt);
