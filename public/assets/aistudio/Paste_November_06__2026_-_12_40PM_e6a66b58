        html += dms.map(c => `
          <div onclick="openConversation('${c.name.replace(/'/g,"\\'")}')" style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.06); cursor:pointer;">
