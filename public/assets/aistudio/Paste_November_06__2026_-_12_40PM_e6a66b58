  function calShiftMonth(delta){
    calMonth += delta;
    if(calMonth < 0){ calMonth = 11; calYear--; }
    if(calMonth > 11){ calMonth = 0; calYear++; }
    renderCalendar();
    document.getElementById('calDayDetail').textContent = 'Tap a highlighted day to see what you worked on.';
  }

  function isWeekOffDayClient(weekOffCsv, altSaturday, year, month, day){
    const dowNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    const dow = dowNames[new Date(year, month, day).getDay()];
    const offDays = String(weekOffCsv || '').split(',').map(s=>s.trim()).filter(Boolean);
    if (offDays.indexOf(dow) !== -1) return true;
    if (dow === 'Saturday' && altSaturday) {
      const nth = Math.ceil(day / 7);
      if (altSaturday === '2nd4th' && (nth === 2 || nth === 4)) return true;
      if (altSaturday === '1st3rd' && (nth === 1 || nth === 3)) return true;
    }
    return false;
  }

  function renderCalendar(){
    const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    document.getElementById('calMonthLabel').textContent = monthNames[calMonth] + ' ' + calYear;

    const firstDayOfWeek = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const datesWithWork = new Set(calData.map(r => r.date));

    let html = ['Su','Mo','Tu','We','Th','Fr','Sa'].map(d => `<div style="color:#666; font-weight:700;">${d}</div>`).join('');
    for (let i = 0; i < firstDayOfWeek; i++) html += '<div></div>';
    for (let day = 1; day <= daysInMonth; day++){
      const dateStr = calYear + '-' + String(calMonth + 1).padStart(2,'0') + '-' + String(day).padStart(2,'0');
      const isOff = isWeekOffDayClient(calExtras.weekOff, calExtras.altSaturday, calYear, calMonth, day);

      let bg = 'transparent', color = '#777', weight = '400';
      if (calExtras.holidayDates && calExtras.holidayDates[dateStr] !== undefined) {
        bg = 'linear-gradient(135deg,#1b8a3c,#4caf50)'; color = '#fff'; weight = '700';
      } else if (calExtras.leaveDates && calExtras.leaveDates[dateStr] !== undefined) {
        bg = 'linear-gradient(135deg,#e08a00,#ffb347)'; color = '#fff'; weight = '700';
      } else if (calExtras.permissionDates && calExtras.permissionDates[dateStr] !== undefined) {
        bg = 'linear-gradient(135deg,#555,#888)'; color = '#fff'; weight = '700';
      } else if (isOff) {
        bg = 'linear-gradient(135deg,#1565c0,#42a5f5)'; color = '#fff'; weight = '700';
      } else if (datesWithWork.has(dateStr)) {
        bg = 'linear-gradient(135deg,#bb0000,#ff3333)'; color = '#fff'; weight = '700';
      }

      html += `<div onclick="calShowDay('${dateStr}')" style="padding:6px 2px; border-radius:6px; cursor:pointer;
        background:${bg}; color:${color}; font-weight:${weight};">${day}</div>`;
    }
    document.getElementById('calGrid').innerHTML = html;
  }

  function calShowDay(dateStr){
    const el = document.getElementById('calDayDetail');
    const [y,m,d] = dateStr.split('-').map(Number);

    if (calExtras.holidayDates && calExtras.holidayDates[dateStr] !== undefined) {
      el.innerHTML = '<b style="color:#4caf50;">' + dateStr + ' — Public Holiday</b><br>' + (calExtras.holidayDates[dateStr] || '(no description)');
      return;
    }
    if (calExtras.leaveDates && calExtras.leaveDates[dateStr] !== undefined) {
      el.innerHTML = '<b style="color:#ffb347;">' + dateStr + ' — On Leave</b><br>' + (calExtras.leaveDates[dateStr] || '(no reason given)');
      return;
    }
    if (calExtras.permissionDates && calExtras.permissionDates[dateStr] !== undefined) {
      const p = calExtras.permissionDates[dateStr];
      const lateTag = p.late ? ' <span style="color:#ff5566; font-weight:700;">(Late — over 2h)</span>' : '';
      el.innerHTML = '<b style="color:#ccc;">' + dateStr + ' — Permission' + lateTag + '</b><br>' +
        (p.reason || '(no reason given)') + (p.hours ? ' · ' + p.hours + 'h' : '');
      return;
    }
    if (isWeekOffDayClient(calExtras.weekOff, calExtras.altSaturday, y, m-1, d)) {
      el.innerHTML = '<b style="color:#42a5f5;">' + dateStr + ' — Week Off</b>';
      return;
    }
    const entries = calData.filter(r => r.date === dateStr);
    if(!entries.length){ el.innerHTML = '<i>No work logged on ' + dateStr + '.</i>'; return; }
    el.innerHTML = '<b style="color:#fff;">' + dateStr + '</b><br>' + entries.map(r =>
      `${r.project} — ${r.taskType}${r.subTask ? ' / ' + r.subTask : ''} (${r.clockIn || '-'}–${r.clockOut || '-'}, ${r.netHrs}h)`
    ).join('<br>');
  }

  // ============== TIME TRACKER ==============
  function pad(n){ return String(n).padStart(2,'0'); }
  function msToDisplay(ms){
    if(!ms || isNaN(ms) || ms < 0) return {h:'00',m:'00',s:'00'};
    const t = Math.floor(ms/1000);
    return { h: pad(Math.floor(t/3600)), m: pad(Math.floor((t%3600)/60)), s: pad(t%60) };
  }
  function setWorkClock(ms){ const t=msToDisplay(ms); wHH.textContent=t.h; wMM.textContent=t.m; wSS.textContent=t.s; }
  function setBreakClock(ms){ const t=msToDisplay(ms); bHH.textContent=t.h; bMM.textContent=t.m; bSS.textContent=t.s; }
  function resetClocks(){ setWorkClock(0); setBreakClock(0); }

  function showSummary(net, brk, total){
    document.getElementById('sumProduction').textContent = net || '00:00:00';
    document.getElementById('sumBreak').textContent = brk || '00:00:00';
    document.getElementById('sumTotal').textContent = total || '00:00:00';
    document.getElementById('summaryBox').classList.add('visible');
  }
  function hideSummary(){ document.getElementById('summaryBox').classList.remove('visible'); }

  function startWorkTimer(){
    if(workInterval) clearInterval(workInterval);
    workInterval = setInterval(()=>{
      if(!workStartTS) return;
      setWorkClock(Math.max(0, (Date.now()-workStartTS) - totalBreakMs));
    },1000);
  }
  function stopWorkTimer(){ if(workInterval){clearInterval(workInterval); workInterval=null;} }
  function startBreakTimer(){
    if(breakInterval) clearInterval(breakInterval);
    breakInterval = setInterval(()=>{
      if(!breakStartTS) return;
      setBreakClock(totalBreakMs + (Date.now()-breakStartTS));
    },1000);
  }
  function stopBreakTimer(){ if(breakInterval){clearInterval(breakInterval); breakInterval=null;} }

  function setMsg(elId, text, type='success'){
    const el = document.getElementById(elId);
    el.className = 'msg ' + (type==='error'?'error':type==='warn'?'warn':'success');
    el.textContent = text;
  }
  function setBtns(state){
    btnStart.disabled = (state !== 'idle');
    btnEnd.disabled = (state === 'idle');
    btnBreakStart.disabled = (state !== 'running');
    btnBreakEnd.disabled = (state !== 'onbreak');
  }

  // FIX: shared helpers
  function isWarn(res){ return res && res.status && res.status.indexOf('⚠') === 0; }
  function resetTimerState(){
    stopWorkTimer(); stopBreakTimer();
    workStartTS = null; breakStartTS = null; totalBreakMs = 0;
    resetClocks(); setBtns('idle');
  }

