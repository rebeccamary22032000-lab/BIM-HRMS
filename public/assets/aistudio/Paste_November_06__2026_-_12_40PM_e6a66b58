    const target = document.getElementById('leaveTargetEmp').value;
    const date = document.getElementById('leaveDate').value;
    const reason = document.getElementById('leaveReason').value.trim();
    if(!date){ setMsg('leaveMsg','Pick a date.','warn'); return; }
    setMsg('leaveMsg','Marking…','warn');
    google.script.run.withSuccessHandler(res=>{
      setMsg('leaveMsg', res.message, res.success ? 'success' : 'error');
      if(res.success){
        document.getElementById('leaveDate').value = '';
        document.getElementById('leaveReason').value = '';
        loadUpcomingLeave();
      }
    }).withFailureHandler(e=>setMsg('leaveMsg','Error: '+e.message,'error'))
      .markLeave(currentUser.role, currentUser.name, target, date, reason);
