  // FIX: clears everything when the server says there is no open session
  function restoreActiveSession(){
    google.script.run.withSuccessHandler(res=>{
      if(!res.active){
        resetTimerState();
        ['project','task','subtask','startStatus','endStatus'].forEach(id => document.getElementById(id).value = '');
        return;
      }

      document.getElementById('project').value = res.project;
      document.getElementById('task').value = res.task;
      document.getElementById('subtask').value = res.subtask;
      document.getElementById('startStatus').value = 'Start';

      workStartTS = res.startTime;
      totalBreakMs = res.accumulatedBreakMs || 0;

      if(res.rowStatus === 'ON BREAK'){
        breakStartTS = res.breakStart;
        stopWorkTimer();
        setBreakClock(totalBreakMs + (Date.now() - breakStartTS));
        startBreakTimer();
        setWorkClock(Math.max(0, (Date.now()-workStartTS) - totalBreakMs));
        setBtns('onbreak');
        setMsg('timeMsg','Resumed — currently on break','warn');
      } else {
        breakStartTS = null;
        stopBreakTimer();
        setWorkClock(Math.max(0, (Date.now()-workStartTS) - totalBreakMs));
        setBreakClock(totalBreakMs);
        startWorkTimer();
        setBtns('running');
        setMsg('timeMsg','Resumed running session','success');
      }
    }).withFailureHandler(e=>{
      setMsg('timeMsg','Could not check active session: '+e.message,'error');
      resetTimerState();
    }).getActiveSession(currentUser.name);
  }

