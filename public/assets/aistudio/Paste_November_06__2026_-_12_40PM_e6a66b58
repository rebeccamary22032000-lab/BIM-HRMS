    .swipe-zone { position:absolute; top:0; height:180px; width:30%; cursor:pointer; z-index:5; }
    .swipe-zone.right { right:0; }
    .swipe-zone.left { left:0; }
    .swipe-dots { position:absolute; bottom:8px; left:50%; transform:translateX(-50%); display:flex; gap:5px; z-index:6; }
    .swipe-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.35); transition:background 0.3s; }
