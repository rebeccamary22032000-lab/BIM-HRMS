      el.innerHTML = rows.map(r => `<div>📅 <b>${r.date}</b> — ${r.name}${r.reason ? ' ('+r.reason+')' : ''}</div>`).join('');
    }).withFailureHandler(e=>{
      el.textContent = 'Could not load: ' + e.message;
