  function onMgmtEmpSelectChange(){
    const name = document.getElementById('mgmtEmpSelect').value;
    if (!name) return;
    google.script.run.withSuccessHandler(profile=>{
      document.getElementById('mgmtJoiningDate').value = profile.joiningDate || '';
      document.getElementById('mgmtEmergencyContact').value = profile.emergencyContact || '';
      document.getElementById('mgmtContactPersonName').value = profile.contactPersonName || '';
      document.getElementById('mgmtContactRelation').value = profile.contactRelation || '';
      const offDays = String(profile.weekOff || '').split(',').map(s=>s.trim());
      document.getElementById('weekOffSunday').checked = offDays.indexOf('Sunday') !== -1;
      document.getElementById('weekOffSaturday').checked = offDays.indexOf('Saturday') !== -1;
      document.getElementById('mgmtAltSaturday').value = profile.altSaturday || '';
    }).getMyProfile(name);
