    if(!currentChatWith && !currentChatGroupId) return;
    input.value = '';
    const imageToSend = pendingChatImage;
    clearChatImagePreview();
    const onDone = res=>{
      if(!res.success){ alert(res.message || 'Could not send.'); return; }
      loadChatThread();
    };
    if (currentChatGroupId) {
      google.script.run.withSuccessHandler(onDone).withFailureHandler(e=>alert('Error: '+e.message))
        .sendGroupMessage(currentUser.name, currentChatGroupId, text, imageToSend);
    } else {
      google.script.run.withSuccessHandler(onDone).withFailureHandler(e=>alert('Error: '+e.message))
        .sendMessage(currentUser.name, currentChatWith, text, imageToSend);
