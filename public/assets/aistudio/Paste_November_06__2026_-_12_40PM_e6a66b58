<script>
  // ============== STATE ==============
  let currentUser = null;
  let discipline = 'mech';
  let workInterval = null, breakInterval = null;
  let workStartTS = null, breakStartTS = null, totalBreakMs = 0;

  const SUBTASK_MECH = ["HVAC","Fire Fighting","Plumbing","Gas"];
  const SUBTASK_MECH_WITH_ANNOTATION = SUBTASK_MECH.concat(["Annotation"]);
  const SUBTASK_ELEC = ["Ceiling Lighting","Floor Lighting","Ground & Lightening Protection","Mechanical Power",
    "Small Power","Exterior Lighting","Containment","Security System","Fire Alarm",
    "Audio - visual & public address","ICT - Information & Communication Technology",
    "BMS - Building Management System","GRMS - Guest Room Management System"];

  const MECH_MAP = {
    "Modeling": SUBTASK_MECH, "Shop drawing": SUBTASK_MECH,
    "Asset Tagging and Documentation": SUBTASK_MECH_WITH_ANNOTATION,
    "Coordination": null, "Documentation": null, "Asbuild": null
  };
  const ELEC_MAP = {
    "Modeling": SUBTASK_ELEC, "Coordination": SUBTASK_ELEC, "Shop drawing": SUBTASK_ELEC,
    "Asset Tagging and Documentation": null, "Documentation": null, "Asbuild": null
