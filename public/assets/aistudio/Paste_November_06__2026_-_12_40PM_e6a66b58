  // ============== IMAGE CROPPER ==============
  let cropperState = null;

  function openImageCropper(fileInputEl, callback){
    const file = fileInputEl.files[0];
    if (!file) { callback(''); return; }
    const reader = new FileReader();
    reader.onload = e=>{
      const img = new Image();
      img.onload = ()=>{
        const viewport = 260;
        const baseScale = Math.max(viewport / img.width, viewport / img.height);
        cropperState = {
          naturalW: img.width, naturalH: img.height,
          baseScale: baseScale, scale: 1,
          x: (viewport - img.width * baseScale) / 2,
          y: (viewport - img.height * baseScale) / 2,
          dragging: false, startX: 0, startY: 0,
          callback: callback
        };
        const cropImg = document.getElementById('cropperImg');
        cropImg.src = e.target.result;
        document.getElementById('cropperZoom').value = 100;
        updateCropperTransform();
        document.getElementById('cropperModal').classList.remove('hidden');
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function updateCropperTransform(){
    if (!cropperState) return;
    const totalScale = cropperState.baseScale * cropperState.scale;
    const img = document.getElementById('cropperImg');
    img.style.width = cropperState.naturalW + 'px';
    img.style.height = cropperState.naturalH + 'px';
    img.style.transform = 'translate(' + cropperState.x + 'px,' + cropperState.y + 'px) scale(' + totalScale + ')';
  }

  function clampCropperPosition(){
    const viewport = 260;
    const totalScale = cropperState.baseScale * cropperState.scale;
    const scaledW = cropperState.naturalW * totalScale, scaledH = cropperState.naturalH * totalScale;
    cropperState.x = scaledW <= viewport ? (viewport - scaledW) / 2 : Math.min(0, Math.max(viewport - scaledW, cropperState.x));
    cropperState.y = scaledH <= viewport ? (viewport - scaledH) / 2 : Math.min(0, Math.max(viewport - scaledH, cropperState.y));
  }

  window.addEventListener('DOMContentLoaded', setupCropperEvents);
  function setupCropperEvents(){
    const viewport = document.getElementById('cropperViewport');
    const zoomSlider = document.getElementById('cropperZoom');

    function pointerDown(clientX, clientY){
      if (!cropperState) return;
      cropperState.dragging = true;
      cropperState.startX = clientX - cropperState.x;
      cropperState.startY = clientY - cropperState.y;
      viewport.style.cursor = 'grabbing';
    }
    function pointerMove(clientX, clientY){
      if (!cropperState || !cropperState.dragging) return;
      cropperState.x = clientX - cropperState.startX;
      cropperState.y = clientY - cropperState.startY;
      clampCropperPosition();
      updateCropperTransform();
    }
    function pointerUp(){
      if (!cropperState) return;
      cropperState.dragging = false;
      viewport.style.cursor = 'grab';
    }

    viewport.addEventListener('mousedown', e => pointerDown(e.clientX, e.clientY));
    window.addEventListener('mousemove', e => pointerMove(e.clientX, e.clientY));
    window.addEventListener('mouseup', pointerUp);
    viewport.addEventListener('touchstart', e => { const t = e.touches[0]; pointerDown(t.clientX, t.clientY); }, { passive: true });
    viewport.addEventListener('touchmove', e => { const t = e.touches[0]; pointerMove(t.clientX, t.clientY); }, { passive: true });
    viewport.addEventListener('touchend', pointerUp);

    zoomSlider.addEventListener('input', ()=>{
      if (!cropperState) return;
      cropperState.scale = zoomSlider.value / 100;
      clampCropperPosition();
      updateCropperTransform();
    });
  }

  function cancelCrop(){
    if (cropperState && cropperState.callback) cropperState.callback(null);
    cropperState = null;
    document.getElementById('cropperModal').classList.add('hidden');
  }

  function confirmCrop(){
    if (!cropperState) return;
    const viewport = 260, outputSize = 400;
    const totalScale = cropperState.baseScale * cropperState.scale;
    const canvas = document.createElement('canvas');
    canvas.width = outputSize; canvas.height = outputSize;
    const ctx = canvas.getContext('2d');
    const img = document.getElementById('cropperImg');
    const renderScale = outputSize / viewport;
    ctx.drawImage(img,
      0, 0, cropperState.naturalW, cropperState.naturalH,
      cropperState.x * renderScale, cropperState.y * renderScale,
      cropperState.naturalW * totalScale * renderScale, cropperState.naturalH * totalScale * renderScale
    );
    const dataUrl = canvas.toDataURL('image/png');
    const callback = cropperState.callback;
    cropperState = null;
    document.getElementById('cropperModal').classList.add('hidden');
    callback(dataUrl);
  }

  let SUPPORTS_WEBP = null;
  function imageOutputFormat(){
    if (SUPPORTS_WEBP === null) {
      const c = document.createElement('canvas');
      c.width = 1; c.height = 1;
      SUPPORTS_WEBP = c.toDataURL('image/webp').indexOf('data:image/webp') === 0;
    }
    return SUPPORTS_WEBP ? 'image/webp' : 'image/jpeg';
  }

  function uploadDataUrlToDrive(dataUrl, filename, callback){
    google.script.run.withSuccessHandler(res=>{
      if (!res.success) { callback(null, res.message); return; }
      callback(res.url, null);
    }).withFailureHandler(e=>{
      callback(null, 'Upload failed: ' + e.message);
    }).uploadImageToDrive(dataUrl, filename);
  }

  function compressDataUrlToFit(dataUrl, callback){
    const format = imageOutputFormat();
    const img = new Image();
    img.onload = ()=>{
      const dim = 600;
      const canvas = document.createElement('canvas');
      canvas.width = dim; canvas.height = dim;
      canvas.getContext('2d').drawImage(img, 0, 0, dim, dim);
      const out = canvas.toDataURL(format, 0.92);
      uploadDataUrlToDrive(out, 'thumb_' + Date.now() + '.webp', callback);
    };
    img.src = dataUrl;
  }

  function readImageAsCompressedDataUrl(fileInputEl, maxDim, quality, callback){
    const file = fileInputEl.files[0];
    if(!file){ callback(''); return; }
    const reader = new FileReader();
    reader.onload = function(e){
      const img = new Image();
      img.onload = function(){
        let w = img.width, h = img.height;
        if (w > h) { if (w > maxDim) { h = Math.round(h * maxDim / w); w = maxDim; } }
        else { if (h > maxDim) { w = Math.round(w * maxDim / h); h = maxDim; } }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        callback(canvas.toDataURL(imageOutputFormat(), quality));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function compressImageToFit(fileInputEl, callback){
    if (!fileInputEl.files[0]) { callback('', null); return; }
    readImageAsCompressedDataUrl(fileInputEl, 1600, 0.88, dataUrl=>{
      uploadDataUrlToDrive(dataUrl, 'poster_' + Date.now() + '.webp', callback);
    });
  }

