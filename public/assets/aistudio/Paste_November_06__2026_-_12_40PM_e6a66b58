<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Add to Home Screen support -->
  <link rel="manifest" href="data:application/manifest+json,%7B%22name%22%3A%22BIM%20Bytes%22%2C%22short_name%22%3A%22BIM%20Bytes%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%230a0a0a%22%2C%22theme_color%22%3A%22%23cc0000%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22https%3A%2F%2Fdrive.google.com%2Fthumbnail%3Fid%3D1xTyRmwSTiYb3WDrWYVzR5_m5kVxeRCjv%26sz%3Dw512%22%2C%22sizes%22%3A%22512x512%22%2C%22type%22%3A%22image%2Fpng%22%7D%5D%7D">
  <link rel="icon" href="https://drive.google.com/thumbnail?id=1xTyRmwSTiYb3WDrWYVzR5_m5kVxeRCjv&sz=w192">
  <link rel="apple-touch-icon" href="https://drive.google.com/thumbnail?id=1xTyRmwSTiYb3WDrWYVzR5_m5kVxeRCjv&sz=w512">
  <meta name="theme-color" content="#cc0000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="BIM Bytes">

  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; overflow-wrap:break-word; word-break:break-word; }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      font-family: 'Rajdhani', sans-serif;
      background:
        linear-gradient(rgba(0,0,0,0.60), rgba(0,0,0,0.68)),
        url('https://drive.google.com/thumbnail?id=1Jo4Ba6GdZwvQ1IYFtRFbfmqoCjhWebQR&sz=w1600')
        center/cover no-repeat;
      padding: 30px 16px;
      overflow-x: hidden;
      width: 100%;
    }

    .card {
      width: 100%;
      max-width: 430px;
      background: rgba(8,4,12,0.78);
      border: 2px solid #cc0000;
      border-radius: 28px;
      padding: 28px 22px 24px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow:
        0 0 0 1px rgba(200,0,0,0.15),
        0 0 30px rgba(200,0,0,0.5),
        0 0 70px rgba(200,0,0,0.25),
        inset 0 0 40px rgba(200,0,0,0.05);
      animation: fadeUp 0.6s cubic-bezier(.22,1,.36,1) both;
      overflow-x: hidden;
      box-sizing: border-box;
    }

    @media (min-width: 700px) {
      .card { max-width: 620px; padding: 40px 40px 32px; }
      .brand-name { font-size: 34px; }
      .menu-btn { padding: 38px 16px; font-size: 17px; }
      .menu-btn .emoji { font-size: 38px; }
    }
    @media (min-width: 1100px) {
      .card { max-width: 900px; padding: 48px 56px 40px; }
      .brand-name { font-size: 40px; }
      .menu-btn { padding: 46px 18px; font-size: 19px; }
      .menu-btn .emoji { font-size: 44px; margin-bottom: 12px; }
    }
    @media (min-width: 1500px) {
      .card { max-width: 1100px; padding: 56px 64px 48px; }
      .brand-name { font-size: 46px; }
      body { font-size: 17px; }
    }

    @keyframes fadeUp { from{opacity:0;transform:translateY(24px);} to{opacity:1;transform:translateY(0);} }

    .hidden { display: none !important; }

    /* ---------- HEADER / BRANDING ---------- */
    .header { text-align:center; margin-bottom:16px; }
    .logo-img {
      width:90px; height:90px; object-fit:contain;
      filter: drop-shadow(0 0 16px rgba(220,0,0,0.9)) drop-shadow(0 0 32px rgba(220,0,0,0.5));
      animation: logoPulse 2.8s ease-in-out infinite;
    }
    @keyframes logoPulse {
      0%,100% { filter: drop-shadow(0 0 14px rgba(220,0,0,0.8)) drop-shadow(0 0 28px rgba(220,0,0,0.4)); }
      50%      { filter: drop-shadow(0 0 26px rgba(255,40,40,1)) drop-shadow(0 0 50px rgba(220,0,0,0.7)); }
    }
    .brand-name {
      font-family:'Orbitron',sans-serif; font-size:26px; font-weight:900;
      color:#fff; letter-spacing:3px; text-shadow: 0 0 20px rgba(255,30,30,0.4);
    }
    .brand-tag {
      font-size:12px; font-weight:700; color:#cc0000;
      letter-spacing:3.5px; margin-top:3px; text-transform:uppercase;
    }

    .divider { display:flex; align-items:center; gap:10px; margin:14px 0 16px; }
    .divider::before, .divider::after {
      content:''; flex:1; height:1px;
      background: linear-gradient(90deg, transparent, rgba(180,0,0,0.8), transparent);
    }
    .divider span { color:#e8e8e8; font-size:13px; font-weight:600; letter-spacing:1.5px; white-space:nowrap; }

    /* ---------- FIELDS ---------- */
    .field {
      display:flex; align-items:center; gap:10px;
      background: rgba(255,255,255,0.96);
      border-radius:12px; padding:2px 14px 2px 12px;
      margin-bottom:10px;
      transition: transform 0.18s, box-shadow 0.18s;
    }
    .field:hover { transform: translateY(-1px) scale(1.01); box-shadow: 0 4px 18px rgba(200,0,0,0.3); }
    .field-icon { font-size:19px; color:#bb0000; flex-shrink:0; width:24px; text-align:center; }
    .field select, .field input {
      flex:1; padding:13px 0; border:none; background:transparent; color:#111;
      font-family:'Rajdhani',sans-serif; font-size:15px; font-weight:600; outline:none;
    }
    .field select { cursor:pointer; appearance:none; -webkit-appearance:none; }
    .chevron { color:#555; font-size:11px; pointer-events:none; flex-shrink:0; }
    .field-label {
      font-family:'Orbitron',sans-serif; font-size:9px; font-weight:700;
      color:#999; letter-spacing:2px; margin: 14px 0 6px;
    }

    .field-row { display:flex; gap:10px; margin-bottom:10px; min-width:0; }
    .field-row .field { flex:1; margin-bottom:0; min-width:0; }
    .field-row .field select, .field-row .field input { min-width:0; width:100%; }
    .field-row .field select { font-size:13px; }

    .field.comment-field { align-items:flex-start; padding-top:8px; padding-bottom:4px; }
    .field.comment-field .field-icon { padding-top:10px; }
    .field.comment-field textarea {
      flex:1; padding:10px 0; border:none; background:transparent; color:#111;
      font-family:'Rajdhani',sans-serif; font-size:14px; font-weight:600;
      outline:none; resize:vertical; min-height:44px;
    }
    .field.comment-field textarea::placeholder { color:#777; }

    /* ---------- BUTTONS ---------- */
    .btn {
      padding:14px 6px; border:none; border-radius:14px;
      font-family:'Orbitron',sans-serif; font-size:15px; font-weight:700;
      letter-spacing:1.5px; color:#fff; cursor:pointer;
      transition: transform 0.18s, box-shadow 0.18s, opacity 0.2s;
      position:relative; overflow:hidden; width:100%; margin-top:16px;
    }
    .btn::after {
      content:''; position:absolute; top:0; left:-100%; width:55%; height:100%;
      background: rgba(255,255,255,0.18); transform: skewX(-18deg); transition:left 0.35s ease;
    }
    .btn:hover::after { left:160%; }
    .btn:hover { transform:translateY(-2px) scale(1.02); }
    .btn:active { transform:scale(0.97); }
    .btn:disabled { opacity:0.4; cursor:not-allowed; transform:none; }

    .btn-red   { background: linear-gradient(135deg,#bb0000,#ff3333); box-shadow:0 0 22px rgba(200,0,0,0.55),0 4px 12px rgba(0,0,0,0.3); }
    .btn-start { background: linear-gradient(135deg,#00a83a,#00e676); box-shadow:0 0 22px rgba(0,220,100,0.55),0 4px 12px rgba(0,0,0,0.3); }
    .btn-end   { background: linear-gradient(135deg,#bb0000,#ff3333); box-shadow:0 0 22px rgba(200,0,0,0.55),0 4px 12px rgba(0,0,0,0.3); }
    .btn-break-start { background: linear-gradient(135deg,#e65100,#ffaa00); box-shadow:0 0 22px rgba(255,150,0,0.5),0 4px 12px rgba(0,0,0,0.3); }
    .btn-break-end   { background: linear-gradient(135deg,#1565c0,#42a5f5); box-shadow:0 0 22px rgba(66,165,245,0.5),0 4px 12px rgba(0,0,0,0.3); }
    .btn-outline {
      background:transparent; color:#ddd; border:1px solid rgba(255,255,255,0.25);
      box-shadow:none; font-size:12px;
    }

    .row-2 { display:flex; gap:10px; }
    .row-2 .btn { flex:1; margin-top:0; }

    /* ---------- LOGIN ---------- */
    #loginScreen .btn { margin-top:18px; }
    .msg { font-size:13px; margin-top:10px; text-align:center; min-height:16px; }
    .msg.error { color:#ff4444; }
    .msg.success { color:#00e676; }
    .msg.warn { color:#ffaa00; }

    /* ---------- MENU ---------- */
    .login-banner {
      background: rgba(200,0,0,0.15); border:1px solid #cc0000; border-radius:12px;
      padding:10px 14px; margin-bottom:18px; display:flex; align-items:center; justify-content:space-between;
    }
    .login-banner-name { font-size:15px; font-weight:700; color:#fff; }
    .login-banner-role {
      font-family:'Orbitron',sans-serif; font-size:9px; font-weight:700; letter-spacing:1px; color:#fff;
      background: linear-gradient(135deg,#bb0000,#ff3333); padding:4px 10px; border-radius:20px;
    }
    .menu-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:6px; }
    .menu-btn {
      background: rgba(255,255,255,0.96); color:#111; border:none; border-radius:16px;
      padding:30px 14px; text-align:center; cursor:pointer; font-weight:700; font-size:15px;
      font-family:'Orbitron',sans-serif; letter-spacing:1px;
      box-shadow: 0 4px 18px rgba(0,0,0,0.3);
      transition: transform 0.18s;
    }
    .menu-btn:hover { transform: translateY(-2px) scale(1.02); }
    .menu-btn .emoji { font-size:30px; display:block; margin-bottom:8px; }
    .back-link {
      display:block; text-align:center; color:#aaa; font-size:12px;
      letter-spacing:1px; margin-top:18px; cursor:pointer; text-decoration:underline;
    }

    /* ---------- WORK TIMER ---------- */
    .clock-wrap { margin:16px 0 14px; }
    .clock-title { display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:10px; }
    .clock-title::before, .clock-title::after { content:''; width:28px; height:1.5px; background:#cc0000; }
    .clock-title span { font-family:'Orbitron',sans-serif; font-size:11px; font-weight:700; color:#fff; letter-spacing:4px; }
    .clocks-row { display:flex; gap:10px; }
    .clock-box { flex:1; background:#080808; border:1px solid #222; border-radius:12px; padding:10px 6px 8px; display:flex; flex-direction:column; align-items:center; }
    .clock-box-title { font-family:'Orbitron',sans-serif; font-size:9px; font-weight:700; letter-spacing:2px; margin-bottom:6px; }
    .clock-box.work .clock-box-title { color:#00e676; }
    .clock-box.break .clock-box-title { color:#ffaa00; }
    .clock-display { display:flex; justify-content:center; align-items:flex-end; gap:1px; }
    .clock-unit { display:flex; flex-direction:column; align-items:center; gap:3px; }
    .clock-num { font-family:'Orbitron',sans-serif; font-size:28px; font-weight:700; letter-spacing:2px; line-height:1; }
    .clock-box.work .clock-num { color:#00e676; text-shadow:0 0 10px rgba(0,230,118,0.9),0 0 25px rgba(0,230,118,0.6); }
    .clock-box.break .clock-num { color:#ffaa00; text-shadow:0 0 10px rgba(255,170,0,0.9),0 0 25px rgba(255,170,0,0.5); }
    .clock-lbl { font-family:'Orbitron',sans-serif; font-size:8px; font-weight:700; letter-spacing:3px; opacity:0.65; }
    .clock-box.work .clock-lbl { color:#00e676; }
    .clock-box.break .clock-lbl { color:#ffaa00; }
    .clock-sep { font-family:'Orbitron',sans-serif; font-size:24px; font-weight:700; padding-bottom:10px; animation: blink 1s step-end infinite; }
    .clock-box.work .clock-sep { color:#00e676; text-shadow:0 0 10px rgba(0,230,118,0.8); }
    .clock-box.break .clock-sep { color:#ffaa00; text-shadow:0 0 10px rgba(255,170,0,0.8); }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.15;} }

    .summary-box { display:none; background:#080808; border:1px solid #333; border-radius:12px; padding:12px 16px; margin-bottom:10px; }
    .summary-box.visible { display:block; }
    .summary-title { font-family:'Orbitron',sans-serif; font-size:9px; font-weight:700; color:#cc0000; letter-spacing:3px; text-align:center; margin-bottom:10px; }
    .summary-row { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid rgba(255,255,255,0.05); }
    .summary-row:last-child { border-bottom:none; }
    .summary-label { font-size:13px; font-weight:600; letter-spacing:1px; }
    .summary-value { font-family:'Orbitron',sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; }
    .summary-row.production .summary-label { color:#00e676; }
    .summary-row.production .summary-value { color:#00e676; text-shadow:0 0 8px rgba(0,230,118,0.7); }
    .summary-row.breakrow .summary-label { color:#ffaa00; }
    .summary-row.breakrow .summary-value { color:#ffaa00; text-shadow:0 0 8px rgba(255,170,0,0.7); }
    .summary-row.total .summary-label { color:#fff; }
    .summary-row.total .summary-value { color:#fff; text-shadow:0 0 8px rgba(255,255,255,0.4); }

    .btns { display:flex; gap:10px; margin-bottom:10px; }
    .btns-break { display:flex; gap:10px; }
    .btns .btn, .btns-break .btn { margin-top:0; }

    /* ---------- QC ---------- */
    .sample-flag { text-align:center; font-size:11px; color:#666; letter-spacing:1px; margin-bottom:18px; }
    .discipline-toggle {
      display:flex; gap:8px; margin-bottom:18px; background:#0c0c0c; border:1px solid #262626;
      border-radius:12px; padding:5px;
    }
    .discipline-btn {
      flex:1; padding:10px 6px; border:none; border-radius:8px; background:transparent; color:#888;
      font-family:'Orbitron',sans-serif; font-size:11px; font-weight:700; letter-spacing:1px;
      cursor:pointer; transition: all 0.2s;
    }
    .discipline-btn.active.mech { background: linear-gradient(135deg,#bb0000,#ff3333); color:#fff; }
    .discipline-btn.active.elec { background: linear-gradient(135deg,#1565c0,#42a5f5); color:#fff; }
    .discipline-btn:disabled { opacity:0.35; cursor:not-allowed; }

    .gate-note {
      font-size:11px; color:#ffaa00; text-align:center; letter-spacing:0.3px; margin-bottom:16px;
      line-height:1.5; background: rgba(255,170,0,0.08); border:1px solid rgba(255,170,0,0.3);
      border-radius:10px; padding:8px 12px;
    }
    .gate-note b { color:#ffcc55; }

    .subtask-wrap { display:none; }
    .subtask-wrap.visible { display:block; }
    .no-subtask-note { display:none; font-size:12px; color:#666; letter-spacing:0.3px; margin:6px 2px 10px; font-style:italic; }
    .no-subtask-note.visible { display:block; }

    .preview-box { display:none; margin-top:16px; background:#0c0c0c; border:1px solid #262626; border-radius:12px; padding:12px 14px; }
    .preview-box.visible { display:block; }
    .preview-title { font-family:'Orbitron',sans-serif; font-size:9px; font-weight:700; color:#00e676; letter-spacing:2px; margin-bottom:8px; }
    .preview-line { font-size:13px; color:#ddd; margin-bottom:4px; line-height:1.5; }
    .preview-line b { color:#fff; }

    /* ---------- LOG TABLES ---------- */
    table { width:100%; min-width:420px; border-collapse:collapse; margin-top:14px; font-size:12px; }
    th, td { text-align:left; padding:7px 6px; border-bottom:1px solid rgba(255,255,255,0.08); color:#ddd; }
    th { color:#888; font-weight:600; font-size:10px; letter-spacing:0.5px; text-transform:uppercase; }
    .badge { padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; }
    .badge.ontime { background:#0f3d22; color:#00e676; }
    .badge.late { background:#3d0f0f; color:#ff4444; }
    .table-wrap { max-height:260px; overflow-y:auto; overflow-x:auto; -webkit-overflow-scrolling:touch; margin-top:6px; }

    .footer { text-align:center; color:rgba(255,255,255,0.38); font-size:12px; letter-spacing:1px; margin-top:16px; }

    /* ================= DASHBOARD SHELL ================= */
    .app-shell {
      display:flex; width:100%; max-width:1400px; min-height:640px;
      background: rgba(8,4,12,0.78); border:2px solid #cc0000; border-radius:28px;
      overflow:hidden; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      box-shadow:
        0 0 0 1px rgba(200,0,0,0.15), 0 0 30px rgba(200,0,0,0.5),
        0 0 70px rgba(200,0,0,0.25), inset 0 0 40px rgba(200,0,0,0.05);
      animation: fadeUp 0.6s cubic-bezier(.22,1,.36,1) both;
    }
    .sidebar {
      width:230px; flex-shrink:0; background:rgba(0,0,0,0.35);
      border-right:1px solid rgba(200,0,0,0.25); padding:26px 18px;
      display:flex; flex-direction:column;
    }
    .sidebar-brand { font-family:'Orbitron',sans-serif; font-weight:900; font-size:21px; color:#fff; letter-spacing:2px; }
    .sidebar-brand-tag { font-size:9px; color:#cc0000; letter-spacing:2.5px; text-transform:uppercase; font-weight:700; margin:2px 0 22px; }
    .sidebar-profile {
      display:flex; flex-direction:column; align-items:center; text-align:center; gap:2px;
      margin-bottom:20px; padding-bottom:18px; border-bottom:1px solid rgba(255,255,255,0.08);
    }
    .sidebar-avatar {
      width:140px; height:140px; border-radius:50%; flex-shrink:0;
      background:linear-gradient(135deg,#bb0000,#ff3333);
      display:flex; align-items:center; justify-content:center;
      font-family:'Orbitron',sans-serif; font-weight:700; font-size:48px; color:#fff;
      overflow:hidden; margin-bottom:12px; border:4px solid rgba(255,255,255,0.15);
      box-shadow:0 0 28px rgba(200,0,0,0.5);
    }
    .sidebar-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
    .sidebar-name { font-size:16px; font-weight:700; color:#fff; line-height:1.3; }
    .sidebar-role { font-size:10.5px; color:#999; letter-spacing:0.5px; margin-top:2px; }
    .sidebar-nav { display:flex; flex-direction:column; gap:4px; flex:1; }
    .nav-item {
      display:flex; align-items:center; gap:11px; padding:11px 12px; border-radius:10px;
      cursor:pointer; color:#aaa; font-size:13px; font-weight:600;
      font-family:'Rajdhani',sans-serif; letter-spacing:0.3px; transition: background .15s, color .15s;
    }
    .nav-item:hover { background:rgba(255,255,255,0.05); color:#fff; }
    .nav-item.active { background:linear-gradient(135deg,#bb0000,#ff3333); color:#fff; box-shadow:0 2px 10px rgba(200,0,0,0.4); }
    .nav-item .nav-emoji { font-size:16px; width:18px; text-align:center; flex-shrink:0; }
    .nav-icon { width:26px; height:26px; flex-shrink:0; stroke:currentColor; fill:none; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
    .sidebar-footer {
      margin-top:14px; padding-top:16px; border-top:1px solid rgba(255,255,255,0.08);
      color:#999; font-size:12.5px; font-weight:600; cursor:pointer;
      display:flex; align-items:center; gap:9px;
    }
    .sidebar-footer:hover { color:#fff; }

    .main-panel { flex:1; min-width:0; display:flex; flex-direction:column; }
    .main-topbar {
      display:flex; align-items:center; justify-content:space-between;
      padding:22px 30px; border-bottom:1px solid rgba(255,255,255,0.06); flex-shrink:0;
    }
    .main-greeting { font-family:'Orbitron',sans-serif; font-size:17px; font-weight:700; color:#fff; letter-spacing:1px; }
    .main-greeting span { color:#ff5566; }
    .topbar-icons { display:flex; align-items:center; gap:16px; }
    .bell-icon { position:relative; font-size:19px; cursor:pointer; }
    .bell-dot {
      position:absolute; top:-2px; right:-3px; width:9px; height:9px; border-radius:50%;
      background:#ff3333; border:2px solid #150a10; display:none;
    }
    .bell-dot.show { display:block; }
    .main-body { flex:1; padding:26px 30px; overflow-y:auto; }

    .home-cards { display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:22px; }
    .ring-card {
      background:rgba(0,0,0,0.32); border:1px solid rgba(255,255,255,0.08);
      border-radius:16px; padding:18px 12px 16px; text-align:center;
    }
    .ring-card .ring-label {
      font-size:10.5px; color:#999; text-transform:uppercase; letter-spacing:1.2px;
      font-weight:700; margin-bottom:10px;
    }
    .ring-svg-wrap { position:relative; width:84px; height:84px; margin:0 auto; }
    .ring-value {
      position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
      font-family:'Orbitron',sans-serif; font-weight:700; font-size:15px; color:#fff;
    }
    .info-cards-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    .info-card {
      background:rgba(0,0,0,0.32); border:1px solid rgba(255,255,255,0.08);
      border-radius:16px; padding:18px;
    }
    .info-card .divider { margin:0 0 12px; }

    .tab-header { display:flex; gap:6px; margin-bottom:14px; }
    .tab-btn {
      flex:1; text-align:center; padding:9px 0; border-radius:10px; cursor:pointer;
